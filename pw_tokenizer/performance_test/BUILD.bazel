load("//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("//pw_build:pw_cc_binary.bzl", "pw_cc_binary")
load("//pw_build:pw_rust_binary.bzl", "pw_rust_binary")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

pw_cc_binary(
    name = "detokenize_cc_benchmark",
    srcs = ["detokenize_benchmark.cc"],
    tags = ["manual"],
    target_compatible_with = incompatible_with_mcu(),
    deps = [
        "//pw_log",
        "//pw_span",
        "//pw_tokenizer:decoder",
    ],
)

pw_rust_binary(
    name = "detokenize_rust_benchmark",
    srcs = ["detokenize_benchmark.rs"],
    edition = "2021",
    tags = ["manual"],
    target_compatible_with = incompatible_with_mcu(),
    deps = [
        "//pw_log/rust:pw_log",
        "//pw_tokenizer/rust:pw_tokenizer",
    ],
)
