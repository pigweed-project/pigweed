menu "pw_stream"

config PIGWEED_STREAM
    bool "Link pw_stream library"
    select PIGWEED_BYTES
    select PIGWEED_RESULT
    select PIGWEED_SPAN
    select PIGWEED_STATUS
    help
      See :ref:`module-pw_stream` for module details. Also requires a
      pw_sys_io backend -- CMake will fail the build if it's not
      configured.

endmenu
