# Gerrit CL Review Agent configuration exposing Pigweed in-tree skills via the
# Code Review Agent Configuration Service (CRACS).
#
# Skills resolve under .agents/skills/<name>/SKILL.md. All entries must carry
# the "code-review-agent" tag and are scoped to the pigweed/pigweed project.

configs: {
  id: "pigweed-code-review-agent"
  display_name: "Code Review Agent"
  description: "Default multi-perspective review agent for pigweed."
  tags: "code-review-agent"
  # Because this entry lists no skills, CRACS also attaches the default
  # multi-perspective review skill; the entries below add path-matched Pigweed
  # skills to it.
  use_default_subagents: true
  include_filters: {
    project: "pigweed/pigweed"
    path_regex: ".*"
  }
}

configs: {
  id: "pigweed-code-review"
  display_name: "Pigweed Code Review"
  description: "Pigweed review checklist (docs/sphinx/code_reviews.rst), language style guides, functionality, and security."
  tags: "code-review-agent"
  skills: "code_review"
  include_filters: {
    project: "pigweed/pigweed"
    path_regex: ".*"
  }
}

configs: {
  id: "pigweed-pw-async2"
  display_name: "Pigweed pw_async2"
  description: "pw_async2 futures, tasks, dispatchers, wakers, and coroutine best practices."
  tags: "code-review-agent"
  skills: "pw_async2"
  include_filters: {
    project: "pigweed/pigweed"
    path_regex: "pw_async2/.*"
  }
}

configs: {
  id: "pigweed-pw-rpc"
  display_name: "Pigweed pw_rpc Services"
  description: "Defining, implementing, and testing pw_rpc services in C++."
  tags: "code-review-agent"
  skills: "pw_rpc_creating_services"
  include_filters: {
    project: "pigweed/pigweed"
    path_regex: "pw_rpc/.*"
  }
}

configs: {
  id: "pigweed-bluetooth"
  display_name: "Pigweed Bluetooth"
  description: "pw_bluetooth_* modules and Bluetooth Core Specification conventions."
  tags: "code-review-agent"
  skills: "bluetooth"
  include_filters: {
    project: "pigweed/pigweed"
    path_regex: "pw_bluetooth[^/]*/.*"
  }
}

configs: {
  id: "pigweed-docs"
  display_name: "Pigweed Docs"
  description: "reStructuredText style guide, changelog, and Doxygen API reference conventions."
  tags: "code-review-agent"
  skills: "docs"
  include_filters: {
    project: "pigweed/pigweed"
    path_regex: ".*\\.rst"
  }
}
