load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@pigweed//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# When debug_assertions is False, all debug_* macros will be compiled out.
#
# The pw_assert crate has it's own feature rather than re-using the rustc
# debug-assertions feature, as it allows for pw_assert debug_* macros to be
# enabled without incurring the additional runtime overhead of rusts
# debug-assertions feature.
bool_flag(
    name = "debug_assertions",
    build_setting_default = False,
)

config_setting(
    name = "debug_assertions_enabled",
    flag_values = {
        ":debug_assertions": "true",
    },
)

bool_flag(
    name = "default_handler",
    build_setting_default = False,
)

config_setting(
    name = "default_handler_enabled",
    flag_values = {
        ":default_handler": "true",
    },
)

bool_flag(
    name = "color",
    build_setting_default = True,
)

config_setting(
    name = "color_enabled",
    flag_values = {
        ":color": "true",
    },
)

rust_library(
    name = "pw_assert",
    srcs = [
        "pw_assert.rs",
    ],
    crate_features = select({
        ":debug_assertions_enabled": ["debug_assertions"],
        "//conditions:default": [],
    }),
    crate_name = "pw_assert",
    edition = "2021",
    deps = [
        ":pw_assert_backend",
    ],
)

rust_test(
    name = "pw_assert_test",
    srcs = [
        "pw_assert_test.rs",
    ],
    edition = "2021",
    target_compatible_with = incompatible_with_mcu(),
    deps = [":pw_assert"],
)

rust_library(
    name = "pw_assert_backend_pw_log",
    srcs = [
        "pw_assert_backend_pw_log.rs",
    ],
    crate_features = select({
        ":color_enabled": ["color"],
        "//conditions:default": [],
    }) + select({
        ":default_handler_enabled": ["default_handler"],
        "//conditions:default": [],
    }),
    crate_name = "pw_assert_backend",
    edition = "2021",
    deps = ["//pw_log/rust:pw_log"],
)

label_flag(
    name = "pw_assert_backend",
    build_setting_default = ":pw_assert_backend_pw_log",
    visibility = ["//visibility:public"],
)

# Duplicate library for 'pw_assert_backend_pw_log' which is only used
# to generate rustdocs.
rust_library(
    name = "pw_assert_backend_pw_log_docs",
    srcs = [
        "pw_assert_backend_pw_log.rs",
    ],
    crate_features = [
        "color",
        "default_handler",
    ],
    crate_name = "pw_assert_backend_pw_log",
    edition = "2021",
    deps = [
        ":pw_assert",
        "//pw_log/rust:pw_log",
    ],
)

# Base pw_assert doc targets
rust_doc_test(
    name = "pw_assert_doc_test",
    crate = ":pw_assert",
    crate_features = [
        "debug_assertions",
    ],
    target_compatible_with = incompatible_with_mcu(),
)

rust_doc(
    name = "pw_assert_doc",
    crate = ":pw_assert",
    crate_features = [
        "debug_assertions",
    ],
    target_compatible_with = incompatible_with_mcu(),
)

# Use the _docs target for rust_test and rust_doc_tests so they get
# the unique crate name.
rust_test(
    name = "pw_assert_backend_pw_log_test",
    crate = ":pw_assert_backend_pw_log_docs",
    edition = "2021",
    target_compatible_with = incompatible_with_mcu(),
)

rust_doc_test(
    name = "pw_assert_backend_pw_log_docs_test",
    crate = ":pw_assert_backend_pw_log_docs",
    target_compatible_with = incompatible_with_mcu(),
)
