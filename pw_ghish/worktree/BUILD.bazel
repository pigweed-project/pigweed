load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//pw_build:compatibility.bzl", "incompatible_with_mcu")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "worktree",
    srcs = [
        "build_driver.go",
        "cmd.go",
        "gerrit_status.go",
        "git.go",
        "ide_driver.go",
        "issue_integration.go",
        "manager.go",
        "register.go",
        "safe_fs.go",
        "state.go",
    ],
    importpath = "pigweed.dev/pw_ghish/worktree",
    target_compatible_with = incompatible_with_mcu(),
    deps = [
        "//pw_ghish",
        "@com_github_andygrunwald_go_gerrit//:go-gerrit",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_test(
    name = "worktree_test",
    srcs = [
        "audit_fixes_test.go",
        "bazel_driver_test.go",
        "cmd_test.go",
        "ide_driver_test.go",
        "integration_test.go",
        "issue_integration_test.go",
        "manager_test.go",
        "register_test.go",
        "state_test.go",
    ],
    embed = [":worktree"],
    tags = [
        # Pure Go test target: Clang C/C++ sanitizers do not instrument Go
        # code (Go uses its native -race detector instead).
        "noasan",
        "nomsan",
        "notsan",
        "noubsan",
    ],
    target_compatible_with = incompatible_with_mcu(),
    deps = [
        "//pw_ghish",
        "@com_github_andygrunwald_go_gerrit//:go-gerrit",
    ],
)
