load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@sphinxdocs//sphinxdocs:sphinx_docs_library.bzl", "sphinx_docs_library")
load("//pw_build:compatibility.bzl", "incompatible_with_mcu")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "pw_ghish",
    srcs = [
        "account.go",
        "auth.go",
        "bug_links.go",
        "bug_normalizer.go",
        "change_context.go",
        "checkout.go",
        "checks.go",
        "cherry_pick.go",
        "close.go",
        "comment.go",
        "comment_tree.go",
        "comments_summary.go",
        "create.go",
        "diff.go",
        "edit.go",
        "exit.go",
        "git_client.go",
        "github_syntax.go",
        "list.go",
        "luci.go",
        "merge.go",
        "profile.go",
        "push.go",
        "push_pipeline.go",
        "ready.go",
        "render.go",
        "reopen.go",
        "review.go",
        "root.go",
        "run.go",
        "status.go",
        "utils.go",
        "view.go",
    ],
    importpath = "pigweed.dev/pw_ghish",
    target_compatible_with = incompatible_with_mcu(),
    deps = [
        "@com_github_andygrunwald_go_gerrit//:go-gerrit",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_binary(
    name = "gh-ish",
    srcs = ["cmd/main.go"],
    target_compatible_with = incompatible_with_mcu(),
    deps = [
        ":pw_ghish",
    ],
)

# Stages the gh-ish binary and its CIPD package definition side-by-side in
# bazel-bin/pw_ghish/cipd/. rules_go emits the binary at gh-ish_/gh-ish, so the
# files have to be copied into a common directory for the relative `file:`
# path in cipd.yaml to resolve.
copy_file(
    name = "cipd_gh_ish",
    src = ":gh-ish",
    out = "cipd/gh-ish",
    allow_symlink = False,
    is_executable = True,
    target_compatible_with = incompatible_with_mcu(),
)

copy_file(
    name = "cipd_yaml",
    src = "cipd.yaml",
    out = "cipd/cipd.yaml",
    allow_symlink = False,
    target_compatible_with = incompatible_with_mcu(),
)

# Build this to produce a directory ready for
# `cipd create -pkg-def bazel-bin/pw_ghish/cipd/cipd.yaml`.
filegroup(
    name = "cipd_package",
    srcs = [
        ":cipd_gh_ish",
        ":cipd_yaml",
    ],
    target_compatible_with = incompatible_with_mcu(),
)

go_test(
