load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//pw_build:compatibility.bzl", "incompatible_with_mcu")

package(default_visibility = ["//pw_ghish:__subpackages__"])

go_library(
    name = "astcheck",
    srcs = [
        "directives.go",
        "loader.go",
        "query.go",
        "wraps.go",
    ],
    importpath = "pigweed.dev/pw_ghish/internal/astcheck",
    target_compatible_with = incompatible_with_mcu(),
)

go_test(
    name = "astcheck_test",
    size = "small",
    srcs = [
        "astcheck_test.go",
        "query_test.go",
        "wraps_test.go",
    ],
    tags = [
        "noasan",
        "nomsan",
        "notsan",
        "noubsan",
    ],
    target_compatible_with = incompatible_with_mcu(),
    deps = [":astcheck"],
)
