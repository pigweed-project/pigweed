import("//build_overrides/pigweed.gni")

import("$dir_pw_build/python.gni")

# ============================================================================
# Binaries / Scripts
# ============================================================================

pw_python_script("find_core_owners") {
  sources = [ "pw_fortifier/find_core_owners.py" ]
  python_deps = [ ":find_core_owners_lib" ]
  pylintrc = "$dir_pigweed/.pylintrc"
  mypy_ini = "$dir_pigweed/.mypy.ini"
  ruff_toml = "$dir_pigweed/.ruff.toml"
}

pw_python_script("demo_freshness_scanner") {
  sources = [ "demo_freshness_scanner.py" ]
  python_deps = [ ":demo_freshness_scanner_lib" ]
  pylintrc = "$dir_pigweed/.pylintrc"
  mypy_ini = "$dir_pigweed/.mypy.ini"
  ruff_toml = "$dir_pigweed/.ruff.toml"
}

pw_python_script("demo_issue_tracker") {
  sources = [ "pw_fortifier/demo_issue_tracker.py" ]
  python_deps = [ ":demo_freshness_scanner_lib" ]
  pylintrc = "$dir_pigweed/.pylintrc"
  mypy_ini = "$dir_pigweed/.mypy.ini"
  ruff_toml = "$dir_pigweed/.ruff.toml"
}

# ============================================================================
# Libraries
# ============================================================================

pw_python_package("find_core_owners_lib") {
  generate_setup = {
    metadata = {
      name = "find_core_owners_lib"
      version = "0.0.1"
    }
  }
  sources = [
    "pw_fortifier/__init__.py",
    "pw_fortifier/code_snippet.py",
    "pw_fortifier/find_core_owners.py",
    "pw_fortifier/git_utils.py",
  ]
  tests = [
    "find_core_owners_test.py",
    "git_utils_test.py",
  ]
  pylintrc = "$dir_pigweed/.pylintrc"
  mypy_ini = "$dir_pigweed/.mypy.ini"
  ruff_toml = "$dir_pigweed/.ruff.toml"
}

