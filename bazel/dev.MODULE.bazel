# Dev Module File
# ===============
# Declarations used only to develop, lint, test, and document Pigweed itself.
#
# Included from //MODULE.bazel. Every dependency, toolchain, and extension here
# must set `dev_dependency = True` (or use a root-only override) so Bazel
# ignores it when @pigweed is consumed as a dependency.
# See https://pigweed.dev/build/dependency_architecture.html.

bazel_dep(name = "rules_doxygen", version = "2.4.2", dev_dependency = True)

