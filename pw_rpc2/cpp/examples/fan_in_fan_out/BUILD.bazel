load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@sphinxdocs//sphinxdocs:sphinx_docs_library.bzl", "sphinx_docs_library")
load("//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("//pw_build:pw_cc_binary.bzl", "pw_cc_binary")
load("//pw_build:python.bzl", "pw_py_binary", "pw_py_library")
load(
    "//pw_protobuf_compiler:pwpb_proto_library.bzl",
    "pwpb_proto_library",
)
load(
    "//pw_protobuf_compiler:pwpb_rpc2_proto_library.bzl",
    "pwpb_rpc2_proto_library",
)

package(default_visibility = ["//:__subpackages__"])

licenses(["notice"])

# Expected output, which the tests in //pw_rpc2/cpp/examples compare against.
exports_files(
    [
        "fan_in_fan_out_client.expected",
        "fan_in_fan_out_server.expected",
    ],
    visibility = ["//pw_rpc2/cpp/examples:__pkg__"],
)

# The framed TCP transport uses POSIX sockets.
hosts_lin_mac = {
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
}

proto_library(
    name = "sensor_proto",
    srcs = ["sensor.proto"],
    import_prefix = "sensor_pb",
    strip_import_prefix = "/pw_rpc2/cpp/examples/fan_in_fan_out",
)

pwpb_proto_library(
    name = "sensor_pwpb",
    deps = [":sensor_proto"],
)

pwpb_rpc2_proto_library(
    name = "sensor_pwpb_rpc2",
    pwpb_proto_library_deps = [":sensor_pwpb"],
    deps = [":sensor_proto"],
)

pw_cc_binary(
    name = "node",
    srcs = ["node.cc"],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        ":sensor_pwpb_rpc2",
        "//pw_allocator",
        "//pw_allocator:libc_allocator",
        "//pw_assert:check",
        "//pw_async2:basic_dispatcher",
        "//pw_async2:coro",
        "//pw_log",
        "//pw_rpc2/cpp",
        "//pw_transport/cpp:framed_tcp",
    ],
)

pw_cc_binary(
    name = "server_coro",
    srcs = ["server_coro.cc"],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        ":sensor_pwpb_rpc2",
        "//pw_allocator",
        "//pw_allocator:libc_allocator",
        "//pw_assert:check",
        "//pw_async2",
        "//pw_async2:basic_dispatcher",
        "//pw_async2:coro",
        "//pw_async2:join",
        "//pw_log",
        "//pw_result",
        "//pw_rpc2/cpp",
        "//pw_span",
        "//pw_status",
        "//pw_transport/cpp:framed_tcp",
        "//pw_transport/cpp:socket",
    ],
)

pw_cc_binary(
    name = "server_polling",
    srcs = ["server_polling.cc"],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        ":sensor_pwpb_rpc2",
        "//pw_allocator",
        "//pw_allocator:libc_allocator",
        "//pw_assert:check",
        "//pw_async2",
        "//pw_async2:basic_dispatcher",
        "//pw_async2:join",
        "//pw_log",
        "//pw_result",
        "//pw_rpc2/cpp",
        "//pw_span",
        "//pw_transport/cpp:framed_tcp",
        "//pw_transport/cpp:socket",
    ],
)

pw_cc_binary(
    name = "client_coro",
    srcs = ["client_coro.cc"],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        ":sensor_pwpb_rpc2",
        "//pw_allocator",
        "//pw_allocator:libc_allocator",
        "//pw_async2",
        "//pw_async2:basic_dispatcher",
        "//pw_async2:coro",
        "//pw_log",
        "//pw_result",
        "//pw_rpc2/cpp",
        "//pw_status",
        "//pw_transport/cpp:framed_tcp",
        "//pw_transport/cpp:socket",
    ],
)

pw_cc_binary(
    name = "client_polling",
    srcs = ["client_polling.cc"],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        ":sensor_pwpb_rpc2",
        "//pw_allocator",
        "//pw_allocator:libc_allocator",
        "//pw_async2",
        "//pw_async2:basic_dispatcher",
        "//pw_log",
        "//pw_result",
        "//pw_rpc2/cpp",
        "//pw_status",
        "//pw_transport/cpp:framed_tcp",
        "//pw_transport/cpp:socket",
    ],
)

pw_py_library(
    name = "cluster",
    srcs = ["cluster.py"],
    imports = ["."],
    target_compatible_with = select(hosts_lin_mac),
)

pw_py_binary(
    name = "cluster_coro",
    srcs = ["cluster_coro.py"],
    data = [
        ":node",
        ":server_coro",
    ],
    main = "cluster_coro.py",
    target_compatible_with = select(hosts_lin_mac),
    deps = [":cluster"],
)

pw_py_binary(
    name = "cluster_polling",
    srcs = ["cluster_polling.py"],
    data = [
        ":node",
        ":server_polling",
    ],
    main = "cluster_polling.py",
    target_compatible_with = select(hosts_lin_mac),
    deps = [":cluster"],
)

sphinx_docs_library(
    name = "docs",
    srcs = [
        "BUILD.bazel",
        "client_coro.cc",
        "client_polling.cc",
        "cluster.py",
        "cluster_coro.py",
        "cluster_polling.py",
        "fan_in_fan_out_client.expected",
        "fan_in_fan_out_server.expected",
        "node.cc",
        "sensor.proto",
        "server_coro.cc",
        "server_polling.cc",
    ],
    target_compatible_with = incompatible_with_mcu(),
)
