load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@sphinxdocs//sphinxdocs:sphinx_docs_library.bzl", "sphinx_docs_library")
load("//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("//pw_build:pw_cc_binary.bzl", "pw_cc_binary")
load(
    "//pw_protobuf_compiler:pw_proto_filegroup.bzl",
    "pw_proto_filegroup",
)
load(
    "//pw_protobuf_compiler:pwpb_proto_library.bzl",
    "pwpb_proto_library",
)
load(
    "//pw_protobuf_compiler:pwpb_rpc2_proto_library.bzl",
    "pwpb_rpc2_proto_library",
)

package(default_visibility = ["//:__subpackages__"])

licenses(["notice"])

# The framed TCP transport uses POSIX sockets.
hosts_lin_mac = {
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
}

# DOCSTAG: [pw_rpc2-examples-echo-codegen]
pw_proto_filegroup(
    name = "echo_proto_and_options",
    srcs = ["echo.proto"],
    options_files = ["echo.pwpb_options"],
)

proto_library(
    name = "echo_proto",
    srcs = [":echo_proto_and_options"],
    import_prefix = "echo_pb",
    strip_import_prefix = "/pw_rpc2/cpp/examples/echo",
)

pwpb_proto_library(
    name = "echo_pwpb",
    deps = [":echo_proto"],
)

pwpb_rpc2_proto_library(
    name = "echo_pwpb_rpc2",
    pwpb_proto_library_deps = [":echo_pwpb"],
    deps = [":echo_proto"],
)
# DOCSTAG: [pw_rpc2-examples-echo-codegen]

pw_cc_binary(
    name = "server_coro",
    srcs = ["server_coro.cc"],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        ":echo_pwpb_rpc2",
        "//pw_allocator",
        "//pw_allocator:libc_allocator",
        "//pw_assert:check",
        "//pw_async2:basic_dispatcher",
        "//pw_async2:coro",
        "//pw_log",
        "//pw_result",
        "//pw_rpc2/cpp:connection",
        "//pw_rpc2/cpp:server",
        "//pw_status",
        "//pw_string:util",
        "//pw_transport/cpp:framed_tcp",
    ],
)

pw_cc_binary(
    name = "server_polling",
    srcs = ["server_polling.cc"],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        ":echo_pwpb_rpc2",
        "//pw_allocator",
        "//pw_allocator:libc_allocator",
        "//pw_assert:check",
        "//pw_async2",
        "//pw_async2:basic_dispatcher",
        "//pw_async2:poll",
        "//pw_log",
        "//pw_result",
        "//pw_rpc2/cpp:connection",
        "//pw_rpc2/cpp:server",
        "//pw_status",
        "//pw_string:util",
        "//pw_transport/cpp:framed_tcp",
    ],
)

pw_cc_binary(
    name = "client_coro",
    srcs = ["client_coro.cc"],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        ":echo_pwpb_rpc2",
        "//pw_allocator",
        "//pw_allocator:libc_allocator",
        "//pw_async2",
        "//pw_async2:basic_dispatcher",
        "//pw_async2:coro",
        "//pw_async2:dispatcher",
        "//pw_log",
        "//pw_result",
        "//pw_rpc2/cpp:client",
        "//pw_rpc2/cpp:connection",
        "//pw_status",
        "//pw_transport/cpp:framed_tcp",
        "//pw_transport/cpp:pw_transport",
    ],
)

pw_cc_binary(
    name = "client_polling",
    srcs = ["client_polling.cc"],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        ":echo_pwpb_rpc2",
        "//pw_allocator",
        "//pw_allocator:libc_allocator",
        "//pw_assert:check",
        "//pw_async2",
        "//pw_async2:basic_dispatcher",
        "//pw_async2:dispatcher",
        "//pw_async2:poll",
        "//pw_log",
        "//pw_result",
        "//pw_rpc2/cpp:client",
        "//pw_rpc2/cpp:connection",
        "//pw_status",
        "//pw_transport/cpp:framed_tcp",
        "//pw_transport/cpp:pw_transport",
    ],
)

sphinx_docs_library(
    name = "docs",
    srcs = [
        "BUILD.bazel",
        "client_coro.cc",
        "client_polling.cc",
        "echo.proto",
        "echo.pwpb_options",
        "server_coro.cc",
        "server_polling.cc",
    ],
    target_compatible_with = incompatible_with_mcu(),
)
