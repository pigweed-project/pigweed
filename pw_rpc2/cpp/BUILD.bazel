load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//pw_enum:pw_cc_enum_library.bzl", "pw_cc_enum_library")
load("//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

pw_cc_enum_library(
    name = "protocol_status",
    enum_headers = ["public/pw_rpc2/internal/protocol_status.h"],
    strip_include_prefix = "public",
    visibility = ["//pw_rpc2:__subpackages__"],
    deps = ["//pw_status"],
)

cc_library(
    name = "packet",
    srcs = ["packet.cc"],
    hdrs = ["public/pw_rpc2/internal/packet.h"],
    strip_include_prefix = "public",
    visibility = ["//pw_rpc2:__subpackages__"],
    deps = [
        ":protocol_status",
        "//pw_assert:assert",
        "//pw_assert:check",
        "//pw_buf",
        "//pw_bytes",
        "//pw_enum",
        "//pw_preprocessor",
        "//pw_result",
        "//pw_status",
    ],
)

pw_cc_test(
    name = "packet_test",
    srcs = ["packet_test.cc"],
    deps = [
        ":packet",
        ":protocol_status",
        "//pw_allocator:testing",
        "//pw_assert:check",
        "//pw_bytes",
        "//pw_enum",
        "//pw_status",
        "//pw_unit_test",
    ],
)

cc_library(
    name = "serialize",
    hdrs = ["public/pw_rpc2/serialize.h"],
    strip_include_prefix = "public",
    deps = [
        "//pw_allocator",
        "//pw_assert:check",
        "//pw_buf",
        "//pw_bytes",
        "//pw_result",
        "//pw_status",
    ],
)

cc_library(
    name = "pwpb_serialize",
    hdrs = [
        "public/pw_rpc2/pwpb_serialize.h",
    ],
    strip_include_prefix = "public",
    deps = [
        ":serialize",
        "//pw_buf",
        "//pw_bytes",
        "//pw_containers:vector",
        "//pw_protobuf",
        "//pw_result",
        "//pw_span",
        "//pw_status",
        "//pw_stream",
        "//pw_string:string",
        "//pw_varint",
    ],
)

pw_cc_test(
    name = "pwpb_serialize_test",
    srcs = ["pwpb_serialize_test.cc"],
    deps = [
        ":pwpb_serialize",
        "//pw_buf",
        "//pw_protobuf",
        "//pw_span",
        "//pw_status",
        "//pw_unit_test",
    ],
)
