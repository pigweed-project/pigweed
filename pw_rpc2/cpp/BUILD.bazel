# The connection layer and the handle types it hands to a method. `Call` and
# `Reader`/`Writer` refer to each other --- `call.cc` defines `ReadFutureBase`,
# and a handle holds a reference to its call --- so they are one target rather
# than a layer and a public face of it.
_CONNECTION_HDRS = [
    "public/pw_rpc2/internal/call.h",
    "public/pw_rpc2/internal/call_handle.h",
    "public/pw_rpc2/internal/client_connection_task.h",
    "public/pw_rpc2/internal/connection_task.h",
    "public/pw_rpc2/internal/control_future.h",
    "public/pw_rpc2/internal/future_base.h",
    "public/pw_rpc2/reader.h",
    "public/pw_rpc2/write_reservation.h",
    "public/pw_rpc2/writer.h",
]

_CONNECTION_DEPS = [
    ":handshake",
    ":method",
    ":packet",
    ":protocol_status",
    ":serialize",
    "//pw_allocator",
    "//pw_assert:assert",
    "//pw_assert:check",
    "//pw_async2",
    "//pw_async2:channel",
    "//pw_async2:future_or_value",
    "//pw_async2:value_future",
    "//pw_buf",
    "//pw_bytes",
    "//pw_containers:algorithm",
    "//pw_containers:dynamic_deque",
    "//pw_containers:intrusive_forward_list",
    "//pw_intrusive_ptr",
    "//pw_log",
    "//pw_polyfill",
    "//pw_result",
    "//pw_status",
    "//pw_sync:interrupt_spin_lock",
    "//pw_sync:lock_annotations",
    "//pw_transport/cpp:pw_transport",
]

cc_library(
    name = "connection",
    srcs = [
        "call.cc",
        "client_connection_task.cc",
        "connection_task.cc",
        "write_reservation.cc",
    ],
    hdrs = _CONNECTION_HDRS,
    strip_include_prefix = "public",
    deps = _CONNECTION_DEPS,
)

_CORO_DEPS = select({
    "//pw_toolchain/cc:c++20_enabled": ["//pw_async2:coro"],
    "//conditions:default": [],
})

cc_library(
    name = "server",
    srcs = [
        "server_call.cc",
        "server_connection_task.cc",
        "server_task.cc",
        "service.cc",
    ],
    hdrs = [
        "public/pw_rpc2/internal/method.h",
        "public/pw_rpc2/internal/method_future.h",
        "public/pw_rpc2/internal/method_invoker.h",
        "public/pw_rpc2/internal/method_traits.h",
        "public/pw_rpc2/internal/server_call.h",
        "public/pw_rpc2/internal/server_connection_task.h",
        "public/pw_rpc2/internal/server_task.h",
        "public/pw_rpc2/server.h",
        "public/pw_rpc2/service.h",
    ],
    strip_include_prefix = "public",
    deps = _CONNECTION_DEPS + _CORO_DEPS + [
        ":connection",
        "//pw_async2:box",
        "//pw_bytes:alignment",
        "//pw_containers:forward_list",
        "//pw_function",
        "//pw_preprocessor",
        "//pw_span",
        "//third_party/fuchsia:stdcompat",
    ],
)

cc_library(
    name = "client",
    srcs = [
        "client.cc",
        "service_client.cc",
    ],
    hdrs = [
        "public/pw_rpc2/client.h",
        "public/pw_rpc2/internal/generated_service_client.h",
        "public/pw_rpc2/service_client.h",
    ],
    strip_include_prefix = "public",
    deps = _CONNECTION_DEPS + [
        ":connection",
    ],
)

cc_library(
    name = "pw_rpc2",
    deps = [
        ":client",
        ":server",
    ],
)

alias(
    name = "cpp",
    actual = ":pw_rpc2",
)

