    dir_pw_result,
    dir_pw_status,
  ]
  deps = [ dir_pw_preprocessor ]
  visibility = _default_visibility
}

pw_source_set("connection") {
  public_configs = [ ":public_include_path" ]
  public = [
    "public/pw_rpc2/internal/call.h",
    "public/pw_rpc2/internal/call_handle.h",
    "public/pw_rpc2/internal/client_connection_task.h",
    "public/pw_rpc2/internal/connection_task.h",
    "public/pw_rpc2/internal/control_future.h",
    "public/pw_rpc2/internal/future_base.h",
    "public/pw_rpc2/reader.h",
    "public/pw_rpc2/write_reservation.h",
    "public/pw_rpc2/writer.h",
  ]
  sources = [
    "call.cc",
    "client_connection_task.cc",
    "connection_task.cc",
    "write_reservation.cc",
  ]
  public_deps = [
    ":handshake",
    ":method",
    ":packet",
    ":protocol_status",
    ":serialize",
    "$dir_pw_assert:assert",
    "$dir_pw_assert:check",
    "$dir_pw_async2:channel",
    "$dir_pw_async2:future_or_value",
    "$dir_pw_async2:value_future",
    "$dir_pw_containers:algorithm",
    "$dir_pw_containers:dynamic_deque",
    "$dir_pw_containers:intrusive_forward_list",
    "$dir_pw_sync:interrupt_spin_lock",
    "$dir_pw_sync:lock_annotations",
    "$dir_pw_transport/cpp:pw_transport",
    dir_pw_allocator,
    dir_pw_async2,
    dir_pw_buf,
    dir_pw_bytes,
    dir_pw_intrusive_ptr,
    dir_pw_log,
    dir_pw_polyfill,
    dir_pw_result,
    dir_pw_status,
  ]
  visibility = _default_visibility
}

_coro_deps = []
if (pw_toolchain_CXX_STANDARD >= pw_toolchain_STANDARD.CXX20) {
  _coro_deps = [ "$dir_pw_async2:coro" ]
}

pw_source_set("server") {
  public_configs = [ ":public_include_path" ]
  public = [
    "public/pw_rpc2/internal/method.h",
    "public/pw_rpc2/internal/method_future.h",
    "public/pw_rpc2/internal/method_invoker.h",
    "public/pw_rpc2/internal/method_traits.h",
    "public/pw_rpc2/internal/server_call.h",
    "public/pw_rpc2/internal/server_connection_task.h",
    "public/pw_rpc2/internal/server_task.h",
    "public/pw_rpc2/server.h",
    "public/pw_rpc2/service.h",
  ]
  sources = [
    "server_call.cc",
    "server_connection_task.cc",
    "server_task.cc",
    "service.cc",
  ]
  public_deps = [
                  ":connection",
                  "$dir_pw_async2:box",
                  "$dir_pw_bytes:alignment",
                  "$dir_pw_containers:forward_list",
                  "$pw_external_fuchsia:stdcompat",
                  dir_pw_function,
                  dir_pw_span,
                ] + _coro_deps
  deps = [ dir_pw_preprocessor ]
  visibility = _default_visibility
}

pw_source_set("pw_rpc2") {
  public_deps = [ ":server" ]
  visibility = _default_visibility
}

pw_source_set("test_utils") {
  testonly = pw_unit_test_TESTONLY
  public_configs = [ ":public_include_path" ]
  public = [
    "public/pw_rpc2/internal/packet_testing.h",
    "public/pw_rpc2/internal/test_utils.h",
  ]
  sources = [ "test_utils.cc" ]
  public_deps = [
    ":connection",
    ":handshake",
    ":method",
    ":packet",
    ":protocol_status",
    ":serialize",
    "$dir_pw_assert:check",
    "$dir_pw_async2:value_future",
    "$dir_pw_containers:inline_deque",
    "$dir_pw_containers:vector",
    "$dir_pw_sync:interrupt_spin_lock",
    "$dir_pw_transport/cpp:pw_transport",
    dir_pw_allocator,
    dir_pw_async2,
    dir_pw_buf,
    dir_pw_bytes,
    dir_pw_log,
    dir_pw_result,
    dir_pw_status,
    dir_pw_unit_test,
  ]
  visibility = _default_visibility
}

pw_test("handshake_test") {
  enable_if = pw_async2_DISPATCHER_FOR_TEST_BACKEND != "" &&
              pw_sync_INTERRUPT_SPIN_LOCK_BACKEND != "" &&
              pw_sync_THREAD_NOTIFICATION_BACKEND != ""
  deps = [
    ":handshake",
    ":packet",
    ":test_utils",
    "$dir_pw_allocator:testing",
    "$dir_pw_async2:testing",
    "$dir_pw_transport/cpp:pw_transport",
    dir_pw_async2,
    dir_pw_bytes,
    dir_pw_status,
  ]
  sources = [ "handshake_test.cc" ]
}

