import("//build_overrides/pigweed.gni")

import("$dir_pw_async2/backend.gni")
import("$dir_pw_build/target_types.gni")
import("$dir_pw_enum/pw_cc_enum_source_set.gni")
import("$dir_pw_sync/backend.gni")
import("$dir_pw_thread/backend.gni")
import("$dir_pw_toolchain/traits.gni")
import("$dir_pw_unit_test/test.gni")

config("public_include_path") {
  include_dirs = [ "public" ]
  visibility = [ ":*" ]
}

# Private while in development.
_default_visibility = [ "$dir_pw_rpc2/*" ]

pw_cc_enum_source_set("protocol_status") {
  enum_headers = [ "public/pw_rpc2/internal/protocol_status.h" ]
  include_dirs = [ "public" ]
  public_deps = [ dir_pw_status ]
  visibility = _default_visibility
}

pw_source_set("packet") {
  public_configs = [ ":public_include_path" ]
  public = [
    "public/pw_rpc2/internal/packet.h",
    "public/pw_rpc2/internal/packet_type.h",
  ]
  sources = [ "packet.cc" ]
  public_deps = [
    ":protocol_status",
    "$dir_pw_assert:assert",
    "$dir_pw_assert:check",
    dir_pw_buf,
    dir_pw_bytes,
    dir_pw_enum,
    dir_pw_preprocessor,
    dir_pw_result,
    dir_pw_status,
  ]
  visibility = _default_visibility
}

pw_test("packet_test") {
  deps = [
    ":packet",
    ":protocol_status",
    "$dir_pw_allocator:testing",
    "$dir_pw_assert:check",
    dir_pw_bytes,
    dir_pw_enum,
    dir_pw_status,
  ]
  sources = [ "packet_test.cc" ]
}

pw_source_set("serialize") {
  public_configs = [ ":public_include_path" ]
  public = [ "public/pw_rpc2/internal/serialize.h" ]
  public_deps = [
    dir_pw_buf,
    dir_pw_bytes,
    dir_pw_result,
    dir_pw_status,
  ]
  visibility = _default_visibility
}

pw_test("serialize_test") {
  deps = [
    ":serialize",
    dir_pw_buf,
    dir_pw_bytes,
    dir_pw_result,
    dir_pw_status,
  ]
  sources = [ "serialize_test.cc" ]
}

pw_source_set("pwpb_serialize") {
  public_configs = [ ":public_include_path" ]
  public = [ "public/pw_rpc2/internal/pwpb_serialize.h" ]
  sources = [ "pwpb_serialize.cc" ]
  public_deps = [
    ":serialize",
    dir_pw_bytes,
    dir_pw_protobuf,
    dir_pw_result,
    dir_pw_span,
    dir_pw_status,
  ]
  deps = [ dir_pw_stream ]
