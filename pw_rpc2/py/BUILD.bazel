load("//pw_build:python.bzl", "pw_py_binary", "pw_py_library", "pw_py_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

pw_py_library(
    name = "pw_rpc2_codegen",
    srcs = [
        "pw_rpc2/__init__.py",
        "pw_rpc2/codegen_common.py",
        "pw_rpc2/codegen_pwpb.py",
        "pw_rpc2/codegen_raw.py",
        "pw_rpc2/plugin.py",
    ],
    imports = ["."],
    deps = [
        "//pw_build:python_protobuf_runtime",
        "//pw_protobuf/py:plugin_library",
    ],
)

pw_py_binary(
    name = "plugin_raw",
    srcs = ["pw_rpc2/plugin_raw.py"],
    imports = ["."],
    main = "pw_rpc2/plugin_raw.py",
    python_version = "PY3",
    deps = [":pw_rpc2_codegen"],
)

pw_py_binary(
    name = "plugin_pwpb",
    srcs = ["pw_rpc2/plugin_pwpb.py"],
    imports = ["."],
    main = "pw_rpc2/plugin_pwpb.py",
    python_version = "PY3",
    deps = [":pw_rpc2_codegen"],
)

pw_py_test(
    name = "codegen_test",
    size = "small",
    srcs = ["codegen_test.py"],
    deps = [
        ":pw_rpc2_codegen",
        "//pw_build:python_protobuf_runtime",
    ],
)

pw_py_test(
    name = "plugin_test",
    size = "small",
    srcs = ["plugin_test.py"],
    deps = [
        ":pw_rpc2_codegen",
        "//pw_build:python_protobuf_runtime",
    ],
)
