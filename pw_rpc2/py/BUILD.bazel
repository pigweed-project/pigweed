load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@com_google_protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("//pw_build:python.bzl", "pw_py_binary", "pw_py_library", "pw_py_test")
load("//pw_enum:pw_py_enum_library.bzl", "pw_py_enum_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

pw_py_enum_library(
    name = "enums",
    enums = [
        "//pw_rpc2:packet_type_enum",
        "//pw_rpc2:protocol_error_enum",
        "//pw_rpc2:rpc_code",
    ],
)

pw_py_library(
    name = "descriptors",
    srcs = ["pw_rpc2/_descriptors.py"],
    imports = ["."],
    deps = ["//pw_build:python_protobuf_runtime"],
)

pw_py_library(
    name = "pw_rpc2",
    srcs = [
        "pw_rpc2/__init__.py",
        "pw_rpc2/_packets.py",
    ],
    imports = ["."],
    deps = [
        ":descriptors",
        ":enums",
    ],
)

pw_py_library(
    name = "pw_rpc2_codegen",
    srcs = [
        "pw_rpc2/codegen_common.py",
        "pw_rpc2/codegen_pwpb.py",
        "pw_rpc2/codegen_raw.py",
        "pw_rpc2/plugin.py",
    ],
    imports = ["."],
    deps = [
        ":descriptors",
        "//pw_build:python_protobuf_runtime",
        "//pw_codegen/py:pw_codegen",
        "//pw_protobuf/py:plugin_library",
    ],
)

pw_py_binary(
    name = "plugin_raw",
    srcs = ["pw_rpc2/plugin_raw.py"],
    imports = ["."],
    main = "pw_rpc2/plugin_raw.py",
    python_version = "PY3",
    deps = [":pw_rpc2_codegen"],
)

pw_py_binary(
    name = "plugin_pwpb",
    srcs = ["pw_rpc2/plugin_pwpb.py"],
    imports = ["."],
    main = "pw_rpc2/plugin_pwpb.py",
    python_version = "PY3",
    deps = [":pw_rpc2_codegen"],
)

pw_py_test(
    name = "codegen_test",
    size = "small",
    srcs = ["codegen_test.py"],
    deps = [
        ":pw_rpc2_codegen",
        "//pw_build:python_protobuf_runtime",
    ],
)

pw_py_test(
    name = "plugin_test",
    size = "small",
    srcs = ["plugin_test.py"],
    deps = [
        ":pw_rpc2_codegen",
        "//pw_build:python_protobuf_runtime",
    ],
)

pw_py_test(
    name = "packets_test",
    size = "small",
    srcs = ["tests/packets_test.py"],
    deps = [":pw_rpc2"],
)

proto_library(
    name = "descriptors_test_proto",
    testonly = True,
    srcs = [
        "tests/descriptors_test_proto2.proto",
        "tests/descriptors_test_proto3.proto",
    ],
    import_prefix = "pw_rpc2_descriptors_test_pb",
    strip_import_prefix = "/pw_rpc2/py/tests",
    visibility = ["//visibility:private"],
)

py_proto_library(
    name = "descriptors_test_py_pb2",
    testonly = True,
    visibility = ["//visibility:private"],
    deps = [":descriptors_test_proto"],
)

pw_py_test(
    name = "descriptors_test",
    size = "small",
    srcs = ["tests/descriptors_test.py"],
    deps = [
        ":descriptors_test_py_pb2",
        ":pw_rpc2",
        "//pw_build:python_protobuf_runtime",
        "//pw_rpc2:pw_rpc2_test_py_pb2",
    ],
)
