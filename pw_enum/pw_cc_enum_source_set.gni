import("//build_overrides/pigweed.gni")
import("$dir_pw_build/python_action.gni")
import("$dir_pw_build/target_types.gni")
import("$dir_pw_toolchain/generate_toolchain.gni")

# Implements pw_cc_enum_source_set for enums defined in C++ headers.
template("_pw_header_enum_source_set") {
  assert(defined(invoker.include_dirs),
         "pw_cc_enum_source_set requires include_dirs")
  _include_dirs = invoker.include_dirs
  assert(_include_dirs == [ _include_dirs[0] ],
         "include_dirs must have exactly one path")

  assert(
      _include_dirs[0] != ".",
      "pw_cc_enum_source_set does not allow '.' as include_dirs. " +
          "Since GN doesn't isolate headers, it is too easy for sources to " +
          "accidentally include original headers instead of generated ones.")

  _out_dir = "${target_gen_dir}/${target_name}"
  _out_files = []
  foreach(_hdr, invoker.enum_headers) {
    _out_files += [ "$_out_dir/include/" + rebase_path(_hdr, _include_dirs[0]) ]
  }

  _base_cc_file = "$_out_dir/${target_name}.base.cc"
  write_file(_base_cc_file, [ "// placeholder" ])

  _base_target = "${target_name}._base"

  pw_source_set(_base_target) {
    forward_variables_from(invoker, [ "testonly" ])
    sources = [ _base_cc_file ]
    _deps = []
    if (defined(invoker.deps)) {
      _deps += invoker.deps
    }
    if (defined(invoker.public_deps)) {
      _deps += invoker.public_deps
    }
    deps = _deps + invoker.enum_deps
    include_dirs = _include_dirs
    public_deps = [
      "$dir_pw_enum:_generate_internal_do_not_use",
      "$dir_pw_tokenizer",
    ]
    visibility = [ ":*" ]
  }

  _generate_target = "${target_name}.generate"

  pw_python_action(_generate_target) {
    forward_variables_from(invoker, [ "testonly" ])
    module = "pw_enum.generate_gn"
    python_deps = [ "$dir_pw_enum/py" ]
    inputs = invoker.enum_headers
    outputs = _out_files
    args = rebase_path(invoker.enum_headers, root_build_dir) + [ "--outputs" ] +
           rebase_path(_out_files, root_build_dir) +
           [
             "--base-cc",
             rebase_path(_base_cc_file, root_build_dir),
             "--toolchain-ninja",
             rebase_path("$root_out_dir/toolchain.ninja", root_build_dir),
             "--target-ninja",
             rebase_path(get_label_info(":$_base_target", "target_out_dir") +
                             "/$_base_target.ninja",
                         root_build_dir),
           ]
    deps = [ ":$_base_target" ]
    visibility = [ ":*" ]
  }

  config("${target_name}.public_includes") {
    # Use -iquote so generated headers take priority over source directories.
    cflags_cc = [ "-iquote" + rebase_path("$_out_dir/include", root_build_dir) ]
    include_dirs = [ "$_out_dir/include" ]
    visibility = [ ":*" ]
  }

  config("${target_name}.original_includes") {
    include_dirs = _include_dirs
    visibility = [ ":*" ]
  }

  pw_source_set(target_name) {
    forward_variables_from(invoker,
                           "*",
                           [
                             "public",
                             "include_dirs",
                             "deps",
                             "public_deps",
                             "enum_headers",
                             "enum_deps",
                             "public_configs",
                           ])

    public = _out_files
    if (defined(invoker.public)) {
      public += invoker.public
    }

    public_deps = [
      "$dir_pw_enum:_generate_internal_do_not_use",
      "$dir_pw_status",
      "$dir_pw_tokenizer",
    ]
    public_deps += invoker.enum_deps
    if (defined(invoker.public_deps)) {
      public_deps += invoker.public_deps
    }

    deps = [ ":$_generate_target" ]
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }

    public_configs = [
      ":${target_name}.public_includes",
      ":${target_name}.original_includes",
    ]
    if (defined(invoker.public_configs)) {
      public_configs += invoker.public_configs
    }
  }
}

# Defines a C++ source set that automatically enables versioned enum
# tokenization.
#
# Enums may be defined in C++ headers that call PW_ENUM() (enum_headers), in
# pw_enum targets (enums), or both. Headers in enum_headers may include headers
# generated from enums.
#
# Args:
#   enum_headers: List of standard .h files containing enum definitions to
#       tokenize.
#   enums: List of pw_enum targets to generate C++ headers for.
#   include_dirs: List containing exactly one path to include for generated
#       headers (required with enum_headers).
#   public: Optional list of general public C++ headers.
#   sources: Optional list of C++ implementation source files.
#   deps: Dependencies.
#   public_deps: Public dependencies.
template("pw_cc_enum_source_set") {
  assert(defined(invoker.enum_headers) || defined(invoker.enums),
         "pw_cc_enum_source_set requires enum_headers, enums, or both")

  _enum_deps = []
  if (defined(invoker.enums)) {
    foreach(enum, invoker.enums) {
      _enum_deps += [ get_label_info(enum, "label_no_toolchain") + ".cc" ]
    }
  }

  if (!defined(invoker.enum_headers)) {
    pw_source_set(target_name) {
      forward_variables_from(invoker, "*", [ "enums" ])
      if (!defined(public_deps)) {
        public_deps = []
      }
      public_deps += _enum_deps
    }
  } else {
    _pw_header_enum_source_set(target_name) {
      forward_variables_from(invoker, "*", [ "enums" ])
      enum_deps = _enum_deps
    }
  }
}
