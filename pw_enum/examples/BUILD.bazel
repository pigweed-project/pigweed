load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//pw_build:python.bzl", "pw_py_test")
load("//pw_enum:pw_cc_enum_library.bzl", "pw_cc_enum_library")
load("//pw_enum:pw_enum.bzl", "pw_enum")
load("//pw_enum:pw_py_enum_library.bzl", "pw_py_enum_library")
load("//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")

# DOCSTAG: [pw_enum-examples-basic-bazel]
pw_cc_enum_library(
    name = "basic_enum",
    enum_headers = ["private/enum_example/basic_enum.h"],
    strip_include_prefix = "private",
)

pw_cc_enum_library(
    name = "other_enum",
    enum_headers = ["private/enum_example/other_enum.h"],
    strip_include_prefix = "private",
    deps = [":basic_enum"],
)

cc_library(
    name = "basic_enum_example",
    srcs = ["basic_enum.cc"],
    deps = [
        ":basic_enum",
        ":other_enum",
        "//pw_enum",
        "//pw_log",
        "//pw_log:args",
        "//pw_tokenizer",
    ],
)
# DOCSTAG: [pw_enum-examples-basic-bazel]

# DOCSTAG: [pw_enum-examples-advanced-bazel]
pw_cc_enum_library(
    name = "advanced_enum",
    enum_headers = ["enum_example/references_other_enum.h"],
    strip_include_prefix = ".",
    deps = [":basic_enum"],
)
# DOCSTAG: [pw_enum-examples-advanced-bazel]

# DOCSTAG: [pw_enum-examples-status-enum-bazel]
pw_cc_enum_library(
    name = "i2c_status",
    enum_headers = ["private/enum_example/i2c_status.h"],
    strip_include_prefix = "private",
)
# DOCSTAG: [pw_enum-examples-status-enum-bazel]

pw_cc_test(
    name = "status_enum_test",
    srcs = ["status_enum_test.cc"],
    deps = [
        ":i2c_status",
        "//pw_status",
    ],
)

# DOCSTAG: [pw_enum-examples-toml-bazel]
pw_enum(
    name = "sensor_enums",
    srcs = ["enum_example/sensor.toml"],
)

pw_cc_enum_library(
    name = "sensor_enums_cc",
    enums = [":sensor_enums"],
)

pw_py_enum_library(
    name = "sensor_enums_py",
    enums = [":sensor_enums"],
)
# DOCSTAG: [pw_enum-examples-toml-bazel]

pw_cc_test(
    name = "toml_enum_test",
    srcs = ["toml_enum_test.cc"],
    deps = [
        ":sensor_enums_cc",
        "//pw_enum",
        "//pw_log",
        "//pw_log:args",
    ],
)

pw_py_test(
    name = "toml_enum_py_test",
    srcs = ["toml_enum_test.py"],
    main = "toml_enum_test.py",
    deps = [":sensor_enums_py"],
)

pw_cc_test(
    name = "basic_enum_test",
    srcs = ["basic_enum_test.cc"],
    deps = [
        ":basic_enum",
        ":basic_enum_example",
        ":other_enum",
        "//pw_log",
        "//pw_log:args",
    ],
)

pw_cc_test(
    name = "traits_test",
    srcs = ["traits.cc"],
    deps = [
        ":basic_enum",
        "//pw_enum",
        "//pw_result",
        "//pw_status",
    ],
)

filegroup(
    name = "docs_sources",
    srcs = [
        "BUILD.bazel",
        "basic_enum.cc",
        "basic_enum_test.cc",
        "enum_example/references_other_enum.h",
        "enum_example/sensor.toml",
        "private/enum_example/basic_enum.h",
        "private/enum_example/i2c_status.h",
        "private/enum_example/other_enum.h",
        "status_enum_test.cc",
        "toml_enum_test.cc",
        "toml_enum_test.py",
        "traits.cc",
    ],
    visibility = ["//pw_enum:__subpackages__"],
)
