load("@docs_tests_pip//:requirements.bzl", "requirement")
load("@pigweed//pw_build:python.bzl", "pw_py_library", "pw_py_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "chromium_files",
    srcs = select({
        "@platforms//os:linux": ["@playwright_chromium_linux_x64//:files"],
        "@platforms//os:macos": ["@playwright_chromium_mac_arm64//:files"],
        "//conditions:default": ["@playwright_chromium_linux_x64//:files"],
    }),
)

pw_py_library(
    name = "helpers",
    srcs = ["helpers.py"],
)

pw_py_test(
    name = "header_test",
    srcs = ["header_test.py"],
    tags = ["local"],
    deps = [
        ":helpers",
    ],
)

pw_py_test(
    name = "search_test",
    srcs = ["search_test.py"],
    data = [":chromium_files"],
    tags = ["local"],
    deps = [
        ":helpers",
        requirement("greenlet"),
        requirement("playwright"),
        requirement("pyee"),
    ],
)
