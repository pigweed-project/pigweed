alias(
    name = "docs",
    actual = "//docs/sphinx:docs",
    tags = ["manual"],
)

alias(
    name = "serve",
    actual = "//docs/sphinx:docs.serve",
    tags = ["manual"],
)

# This references a hidden target with no stability guarantee so if it breaks
# it's our problem.
alias(
    name = "sources",
    actual = "//docs/sphinx:_sphinx/_sources",
    tags = ["manual"],
    visibility = ["//visibility:private"],
)
