load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@sphinxdocs//sphinxdocs:sphinx_docs_library.bzl", "sphinx_docs_library")
load("//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

cc_library(
    name = "pw_tls_client_mbedtls",
    srcs = ["tls_client_mbedtls.cc"],
    hdrs = [
        "public/pw_tls_client_mbedtls/backend_types.h",
        "public_overrides/pw_tls_client_backends/backend_types.h",
    ],
    implementation_deps = ["//pw_assert:check"],
    includes = [
        "public",
        "public_overrides",
    ],
    deps = [
        "//pw_log",
        "//pw_preprocessor",
        "//pw_status",
        "//pw_string:string",
        "//pw_tls_client:entropy",
        "//pw_tls_client:pw_tls_client.facade",
        "@mbedtls",
    ],
)

config_setting(
    name = "_is_active_backend",
    flag_values = {
        "//pw_tls_client:backend": ":pw_tls_client_mbedtls",
    },
    visibility = ["//visibility:private"],
)

pw_cc_test(
    name = "tls_client_mbedtls_test",
    srcs = [
        "tls_client_mbedtls_test.cc",
    ],
    target_compatible_with = select({
        ":_is_active_backend": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//pw_status",
        "//pw_stream",
        "//pw_tls_client",
    ],
)

sphinx_docs_library(
    name = "docs",
    srcs = [
        "docs.rst",
        "module.toml",
    ],
    prefix = "pw_tls_client_mbedtls/",
    target_compatible_with = incompatible_with_mcu(),
)
