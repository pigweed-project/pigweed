import("//build_overrides/pigweed.gni")

import("$dir_pw_build/python.gni")

pw_python_package("py") {
  setup = [
    "pyproject.toml",
    "setup.cfg",
  ]
  sources = [
    "pw_daq/__init__.py",
    "pw_daq/__main__.py",
    "pw_daq/backend.py",
    "pw_daq/backend_registry.py",
    "pw_daq/backends/__init__.py",
    "pw_daq/backends/mock_daq/__init__.py",
    "pw_daq/backends/mock_daq/mock_backend.py",
    "pw_daq/cli.py",
    "pw_daq/cli_parsing.py",
    "pw_daq/common.py",
    "pw_daq/config.py",
    "pw_daq/lib.py",
  ]
  tests = [
    "backend_test.py",
    "cli_test.py",
    "lib_test.py",
  ]
  python_deps = [
    "$dir_pw_cli/py",
    "$dir_pw_config_loader/py",
  ]
  inputs = [ "pw_daq/py.typed" ]
  pylintrc = "$dir_pigweed/.pylintrc"
  mypy_ini = "$dir_pigweed/.mypy.ini"
  pyrefly_toml = "$dir_pigweed/.pyrefly.toml"
  ruff_toml = "$dir_pigweed/.ruff.toml"
}
