pw.protobuf.test.SensorReport.label max_size:32
pw.protobuf.test.SensorReport.payload max_size:64
pw.protobuf.test.SensorReport.samples max_count:8
pw.protobuf.test.ResponseInfo.key_string max_size:16
// SensorLog.tag and SensorLog.readings have no max_size/max_count, so they
// default to callbacks in both pw_protobuf and Nanopb.
pw.protobuf.test.NestedLeaf.data max_size:1024
