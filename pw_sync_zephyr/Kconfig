menu "pw_sync"

config PIGWEED_SYNC
    bool
    select PIGWEED_PREPROCESSOR

choice PIGWEED_SYNC_MUTEX_BACKEND
    prompt "pw_sync.mutex backend used"
    default PIGWEED_SYNC_MUTEX
    help
      Defaults to Pigweed's Zephyr backend. Choose "none" to provide
      your own with pw_set_backend().

config PIGWEED_SYNC_MUTEX
    bool "Link pw_sync.mutex library"
    select PIGWEED_SYNC
    select PIGWEED_POLYFILL
    help
      See :ref:`module-pw_sync` for module details.

config PIGWEED_SYNC_MUTEX_NONE
    bool "Provide your own pw_sync.mutex backend"
    help
      Pigweed's Zephyr backend is not linked in. Wire up your own via
      pw_set_backend() or an equivalent mechanism.

endchoice

choice PIGWEED_SYNC_TIMED_MUTEX_BACKEND
    prompt "pw_sync.timed_mutex backend used"
    default PIGWEED_SYNC_TIMED_MUTEX
