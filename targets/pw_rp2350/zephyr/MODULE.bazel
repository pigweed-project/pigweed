module(
    name = "pw_rp2350_zephyr",
    version = "0.0.1",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_platform", version = "0.1.0")

# LINT.IfChange(rules_python)
bazel_dep(name = "rules_python", version = "2.4.6")
# LINT.ThenChange(//MODULE.bazel:rules_python, //docs/tests/MODULE.bazel:rules_python, //pw_build/workflows_launcher/MODULE.bazel:rules_python, //pw_ide/py/integration_test.py:rules_python, //pw_kernel/examples/adventure/MODULE.bazel:rules_python, //targets/pw_rp2350/zephyr/MODULE.bazel:rules_python)

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "pigweed")
local_path_override(
    module_name = "pigweed",
    path = "../../..",
)

include("//:zephyr_dep.MODULE.bazel")

# Register local host toolchain first so host tools compile with system compiler
register_toolchains(
    "@pigweed//pw_toolchain/host_clang:host_cc_toolchain_linux",
    "@pigweed//pw_toolchain/host_clang:host_cc_toolchain_macos",
)

# Register zephyr toolchains
register_toolchains(
    "@zephyr//toolchain:all",
)

# Configure Python toolchain
python = use_extension("@rules_python//python/extensions:python.bzl", "python")

# LINT.IfChange(python_version)
python.toolchain(
    configure_coverage_tool = True,
    is_default = True,
    python_version = "3.12",
)

# LINT.ThenChange(//MODULE.bazel:python_version, //docs/tests/MODULE.bazel:python_version, //pw_build/workflows_launcher/MODULE.bazel:python_version, //pw_ide/py/integration_test.py:python_version, //pw_kernel/examples/adventure/MODULE.bazel:python_version, //targets/pw_rp2350/zephyr/MODULE.bazel:python_version)
use_repo(python, "pythons_hub")

# Import pip dependencies
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
use_repo(pip, "zephyr_pip_deps")

# Configure Zephyr setup environment
zephyr_setup = use_extension("@zephyr//bazel:setup.bzl", "zephyr_setup")
zephyr_setup.env(
    apps_dirs = ["//:MODULE.bazel"],
    boards_dirs = [
        "//:MODULE.bazel",
    ],
    modules = [
        "@pigweed//zephyr:module.yml",
    ],
)
use_repo(
    zephyr_setup,
    "zephyr_index",
    "zephyr_kconfig",
    "zephyr_state",
    "zephyr_version",
)

pw_zephyr_config = use_extension("@pigweed//zephyr/config:pw_zephyr_config.bzl", "pw_zephyr_config")

override_repo(
    pw_zephyr_config,
    kconfig = "zephyr_kconfig",
    zephyr = "zephyr",
    zephyr_version = "zephyr_version",
)

bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "rules_rust_bindgen", version = "0.70.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(versions = [])

single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = [
        # Once rules_rust 0.71.0 is released, we can remove this patch.
        "//bazel_patches:0003-Add-thumbv6m-and-more-thumbv7m-and-thumbv8m-triples.patch",
    ],
)

pw_rust = use_extension("@pigweed//pw_toolchain/rust:extensions.bzl", "pw_rust")
pw_rust.toolchain(
    cipd_tag = "git_revisions:d32e620a107b5b3dccd9ddb53fa124956a92b589,a3f244e2d5550e110daee562b88bee247b75d66c",
    rust_analyzer_cipd_tag = "git_revision:e79b8223f7e0f000d75e7bf9a8f5b590ff7eb7f8",
    rust_bindgen_cipd_tag = "git_revisions:93726885850c20847ac445664bc7bb2b827d9642,deb6854eec93529b2bd30178d400ad2ee7665cd4",
)
use_repo(
    pw_rust,
    "pw_rust_toolchains",
    "rust_bindgen_linux_aarch64",
    "rust_bindgen_linux_x86_64",
    "rust_bindgen_macos_aarch64",
)

register_toolchains(
    "@pw_rust_toolchains//:all",
    "@pigweed//pw_toolchain/rust:prebuilt_bindgen_toolchain_linux_aarch64",
    "@pigweed//pw_toolchain/rust:prebuilt_bindgen_toolchain_linux_x86_64",
    "@pigweed//pw_toolchain/rust:prebuilt_bindgen_toolchain_macos_aarch64",
)
