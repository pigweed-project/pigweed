# Options required to compile picotool and pioasm with exceptions enabled
common --per_file_copt=external.*picotool.*@-fexceptions,-frtti
common --host_per_file_copt=external.*picotool.*@-fexceptions,-frtti
common --host_per_file_copt=external.*pioasm.*@-fexceptions,-frtti

# Ignore warnings in external dependencies
common --per_file_copt=external/.*@-w
common --host_per_file_copt=external/.*@-w

# Use Zephyr llvm toolchain
common --@zephyr-bazel//toolchain:zephyr_toolchain_variant=llvm

# Configure Pigweed platform deps and rust logging backend
build --@pigweed//targets/pw_rp2350:platform_deps=//app:boot
build --@pigweed//pw_assert:assert_backend=@pigweed//pw_assert_trap:assert_backend
build --@pigweed//pw_assert:assert_backend_impl=@pigweed//pw_assert_trap:impl
build --@pigweed//pw_assert:check_backend=@pigweed//pw_assert_trap:check_backend
build --@pigweed//pw_assert:check_backend_impl=@pigweed//pw_assert_trap:impl
build --@pigweed//pw_chrono:system_clock_backend=@pigweed//pw_chrono_zephyr:system_clock
build --@pigweed//pw_log/rust:pw_log_backend=@pigweed//targets/pw_rp2350:rust_log_basic_backend
build --@pigweed//pw_log:backend=@pigweed//pw_log_basic
build --@pigweed//pw_log:backend_impl=@pigweed//pw_log_basic:impl
build --@pigweed//pw_sync:mutex_backend=@pigweed//pw_sync_zephyr:mutex
build --@pigweed//pw_rpc/system_server:backend=@pigweed//pw_hdlc:hdlc_sys_io_system_server
build --@pigweed//pw_sync:interrupt_spin_lock_backend=@pigweed//pw_sync_baremetal:interrupt_spin_lock
build --@pigweed//pw_sync:thread_notification_backend=@pigweed//pw_sync_zephyr:thread_notification
build --@pigweed//pw_sys_io:backend=@pigweed//pw_sys_io_zephyr:backend
build --@pigweed//pw_unit_test:main=//unit_test_app:unit_test_boot_cc
build --@pigweed//pw_thread:id_backend=@pigweed//pw_thread_zephyr:id
build --@pigweed//pw_thread:sleep_backend=@pigweed//pw_thread_zephyr:sleep
build --@pigweed//pw_thread:thread_backend=@pigweed//pw_thread_zephyr:thread
build --@pigweed//pw_thread/rust:pw_thread_backend=@pigweed//pw_thread/rust:pw_thread_backend_zephyr
build --@pigweed//pw_time/rust:pw_time_backend=@pigweed//pw_time/rust:pw_time_backend_zephyr

# Config to run tests on target
build:pw_rp2350_zephyr --platforms=//boards:rp2350a_m33
test:pw_rp2350_zephyr --run_under=@pigweed//targets/rp2040/py:unit_test_client

# Remote execution config definitions
# ===================================
# Use the remote cache. This will only work for users who have permission to access it.
common:remote_cache --bes_backend="buildeventservice.googleapis.com"
common:remote_cache --bes_instance_name=pigweed-rbe-open
common:remote_cache --bes_results_url="https://source.cloud.google.com/results/invocations/"
common:remote_cache --bes_timeout=600s
common:remote_cache --experimental_remote_cache_eviction_retries=5
common:remote_cache --google_default_credentials=true
# Required to use buildeventservice on Bazel 8+.
# TODO: b/345556899 -- Remove this flag when no longer required.
common:remote_cache --legacy_important_outputs
common:remote_cache --remote_cache=grpcs://remotebuildexecution.googleapis.com
common:remote_cache --remote_instance_name=projects/pigweed-rbe-open/instances/default-instance
common:remote_cache --remote_upload_local_results=false
