load("@rules_rust//rust:defs.bzl", "rust_library")
load("@zephyr//:cc.bzl", "zephyr_app", "zephyr_cc_library")

package(default_visibility = ["//visibility:public"])

zephyr_app(
    name = "unit_test_app",
    testonly = True,
)

rust_library(
    name = "unit_test_boot",
    testonly = True,
    srcs = ["unit_test_boot.rs"],
    crate_name = "boot",
    edition = "2021",
    target_compatible_with = ["@zephyr//constraints:zephyr_autoconf_force_included"],
    deps = [
        ":unit_test_boot_cc",
        "@pigweed//pw_log/rust:pw_log",
    ],
)

zephyr_cc_library(
    name = "unit_test_boot_cc",
    testonly = True,
    srcs = ["unit_test_boot.cc"],
    deps = [
        "@pigweed//pw_log",
        "@pigweed//pw_thread_zephyr:thread",
        "@pigweed//targets/pw_rp2350:unit_test_server",
        "@zephyr//:board_deps",
        "@zephyr//arch",
        "@zephyr//drivers",
        "@zephyr//lib",
        "@zephyr//subsys",
    ],
)
