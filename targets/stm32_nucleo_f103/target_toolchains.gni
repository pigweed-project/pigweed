import("//build_overrides/pigweed.gni")

import("$dir_pigweed/targets/common/freertos.gni")
import("$dir_pw_boot/backend.gni")
import("$dir_pw_boot_cortex_m/toolchain.gni")
import("$dir_pw_compilation_testing/negative_compilation_test.gni")
import("$dir_pw_interrupt/backend.gni")
import("$dir_pw_log/backend.gni")
import("$dir_pw_malloc/backend.gni")
import("$dir_pw_perf_test/perf_test.gni")
import("$dir_pw_rpc/system_server/backend.gni")
import("$dir_pw_sys_io/backend.gni")
import("$dir_pw_toolchain/arm_gcc/toolchains.gni")
import("$pw_external_freertos/freertos.gni")

declare_args() {
  # Enable automatic on-device test execution via pw_target_runner.
  pw_targets_ENABLE_STM32_NUCLEO_F103_TEST_RUNNER = false
}

_common_target_config = {
  pw_compilation_testing_NEGATIVE_COMPILATION_ENABLED = host_os != "win"

  pw_build_DEFAULT_MODULE_CONFIG =
      "$dir_pigweed/targets/stm32_nucleo_f103:pigweed_module_config"

  pw_perf_test_TIMER_INTERFACE_BACKEND = "$dir_pw_perf_test:arm_cortex_timer"

  pw_build_EXECUTABLE_TARGET_TYPE = "stm32_nucleo_f103_executable"
  pw_build_EXECUTABLE_TARGET_TYPE_FILE =
      get_path_info("stm32_nucleo_f103_executable.gni", "abspath")

  pw_bloat_BLOATY_CONFIG = "$dir_pw_boot_cortex_m/bloaty_config.bloaty"

  if (pw_targets_ENABLE_STM32_NUCLEO_F103_TEST_RUNNER) {
    _test_runner_script = "py/stm32_nucleo_f103_utils/unit_test_client.py"
    pw_unit_test_AUTOMATIC_RUNNER =
        get_path_info(_test_runner_script, "abspath")
  }

  # Common facade backends
  pw_assert_BACKEND = dir_pw_assert_basic
  pw_boot_BACKEND = "$dir_pw_boot_cortex_m"
  pw_interrupt_CONTEXT_BACKEND = "$dir_pw_interrupt_cortex_m:context"
  pw_log_BACKEND = dir_pw_log_basic
  pw_malloc_BACKEND = "$dir_pw_malloc:best_fit"
  pw_sys_io_BACKEND = "$dir_pigweed/targets/stm32_nucleo_f103:sys_io"
  pw_rpc_system_server_BACKEND = "$dir_pw_hdlc:hdlc_sys_io_system_server"

  pw_boot_cortex_m_LINK_CONFIG_DEFINES = []
  pw_boot_cortex_m_LINK_CONFIG_DEFINES = [
    "PW_BOOT_VECTOR_TABLE_BEGIN=0x08000000",
    "PW_BOOT_VECTOR_TABLE_SIZE=512",
    "PW_BOOT_FLASH_BEGIN=0x08000200",
    "PW_BOOT_FLASH_SIZE=130560",
    "PW_BOOT_RAM_BEGIN=0x20000000",
    "PW_BOOT_RAM_SIZE=20K",
    "PW_BOOT_HEAP_SIZE=3K",
    "PW_BOOT_MIN_STACK_SIZE=1K",
  ]

  pw_build_LINK_DEPS = []
  pw_build_LINK_DEPS = [
    "$dir_pw_assert:impl",
    "$dir_pw_log:impl",
    "$dir_pw_toolchain/arm_gcc:arm_none_eabi_gcc_support",
  ]

  current_cpu = "arm"
  current_os = ""
}

_baremetal_target_config = {
  forward_variables_from(_common_target_config, "*")
  pw_unit_test_MAIN = "$dir_pw_unit_test:simple_printing_main"
  pw_sync_INTERRUPT_SPIN_LOCK_BACKEND =
      "$dir_pw_sync_baremetal:interrupt_spin_lock"
  pw_sync_MUTEX_BACKEND = "$dir_pw_sync_baremetal:mutex"
  pw_rpc_CONFIG = "$dir_pw_rpc:disable_global_mutex"
}

_freertos_target_config = {
  forward_variables_from(_common_target_config, "*")
  forward_variables_from(pw_targets_FREERTOS_BACKEND_GROUP, "*")
  if (dir_pw_third_party_freertos == "") {
    pw_thread_THREAD_ITERATION_BACKEND = ""
  }
  pw_third_party_freertos_DISABLE_TASKS_STATICS = true
  pw_third_party_freertos_CONFIG =
      "$dir_pigweed/targets/stm32_nucleo_f103:freertos_config"
  pw_third_party_freertos_PORT = "$pw_external_freertos:arm_cm3"
  pw_unit_test_MAIN = "$dir_pigweed/targets/stm32_nucleo_f103:unit_test_main"
}

_toolchain_properties = {
  final_binary_extension = ".elf"
}

_target_default_configs = [
  "$dir_pw_build:extra_strict_warnings",
  "$dir_pw_toolchain/arm_gcc:enable_float_printf",
]

pw_target_toolchain_stm32_nucleo_f103 = {
  _excluded_members = [
    "defaults",
    "name",
  ]

  debug = {
    name = "stm32_nucleo_f103_debug"
    _toolchain_base = pw_toolchain_arm_gcc.cortex_m3_debug
    forward_variables_from(_toolchain_base, "*", _excluded_members)
    forward_variables_from(_toolchain_properties, "*")
    defaults = {
      forward_variables_from(_toolchain_base.defaults, "*")
      forward_variables_from(_baremetal_target_config, "*")
      default_configs += _target_default_configs
    }
  }

  speed_optimized = {
    name = "stm32_nucleo_f103_speed_optimized"
    _toolchain_base = pw_toolchain_arm_gcc.cortex_m3_speed_optimized
    forward_variables_from(_toolchain_base, "*", _excluded_members)
    forward_variables_from(_toolchain_properties, "*")
    defaults = {
      forward_variables_from(_toolchain_base.defaults, "*")
      forward_variables_from(_baremetal_target_config, "*")
      default_configs += _target_default_configs
    }
  }

  size_optimized = {
    name = "stm32_nucleo_f103_size_optimized"
    _toolchain_base = pw_toolchain_arm_gcc.cortex_m3_size_optimized
    forward_variables_from(_toolchain_base, "*", _excluded_members)
    forward_variables_from(_toolchain_properties, "*")
    defaults = {
      forward_variables_from(_toolchain_base.defaults, "*")
      forward_variables_from(_baremetal_target_config, "*")
      default_configs += _target_default_configs
    }
  }

  freertos_debug = {
    name = "stm32_nucleo_f103_freertos_debug"
    _toolchain_base = pw_toolchain_arm_gcc.cortex_m3_debug
    forward_variables_from(_toolchain_base, "*", _excluded_members)
    forward_variables_from(_toolchain_properties, "*")
    defaults = {
      forward_variables_from(_toolchain_base.defaults, "*")
      forward_variables_from(_freertos_target_config, "*")
      default_configs += _target_default_configs
    }
  }

  freertos_speed_optimized = {
    name = "stm32_nucleo_f103_freertos_speed_optimized"
    _toolchain_base = pw_toolchain_arm_gcc.cortex_m3_speed_optimized
    forward_variables_from(_toolchain_base, "*", _excluded_members)
    forward_variables_from(_toolchain_properties, "*")
    defaults = {
      forward_variables_from(_toolchain_base.defaults, "*")
      forward_variables_from(_freertos_target_config, "*")
      default_configs += _target_default_configs
    }
  }

  freertos_size_optimized = {
    name = "stm32_nucleo_f103_freertos_size_optimized"
    _toolchain_base = pw_toolchain_arm_gcc.cortex_m3_size_optimized
    forward_variables_from(_toolchain_base, "*", _excluded_members)
    forward_variables_from(_toolchain_properties, "*")
    defaults = {
      forward_variables_from(_toolchain_base.defaults, "*")
      forward_variables_from(_freertos_target_config, "*")
      default_configs += _target_default_configs
    }
  }
}

pw_target_toolchain_stm32_nucleo_f103_list = [
  pw_target_toolchain_stm32_nucleo_f103.debug,
  pw_target_toolchain_stm32_nucleo_f103.speed_optimized,
  pw_target_toolchain_stm32_nucleo_f103.size_optimized,
  pw_target_toolchain_stm32_nucleo_f103.freertos_debug,
  pw_target_toolchain_stm32_nucleo_f103.freertos_speed_optimized,
  pw_target_toolchain_stm32_nucleo_f103.freertos_size_optimized,
]
