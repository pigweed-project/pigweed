load("@rules_platform//platform_data:defs.bzl", "platform_data")
load("//pw_build:python.bzl", "pw_py_binary", "pw_py_library")

package(default_visibility = ["//visibility:public"])

# Allow other packages to use this configuration file.
exports_files(["stm32f429i_disc1_utils/openocd_stm32f4xx.cfg"])

pw_py_library(
    name = "stm32f429i_disc1_utils",
    srcs = [
        "stm32f429i_disc1_utils/__init__.py",
        "stm32f429i_disc1_utils/stm32f429i_detector.py",
        "stm32f429i_disc1_utils/unit_test_client.py",
        "stm32f429i_disc1_utils/unit_test_runner.py",
        "stm32f429i_disc1_utils/unit_test_server.py",
    ],
    data = ["stm32f429i_disc1_utils/openocd_stm32f4xx.cfg"],
    imports = ["."],
    deps = [
        "//pw_cli/py:pw_cli",
        "//pw_hdlc/py:pw_hdlc",
        "//pw_log:log_proto_py_pb2",
        "//pw_log/py:pw_log",
        "//pw_log_rpc/py:pw_log_rpc",
        "//pw_system/py:pw_system_lib",
        "//pw_tokenizer:tokenizer_proto_py_pb2",
        "//pw_tokenizer/py:pw_tokenizer",
        "//pw_unit_test:unit_test_py_pb2",
        "//pw_unit_test/py:pw_unit_test",
        "@pigweed_python_packages//coloredlogs",
        "@pigweed_python_packages//pyserial",
    ],
)

pw_py_binary(
    name = "unit_test_runner",
    srcs = [
        "stm32f429i_disc1_utils/unit_test_runner.py",
    ],
    main = "stm32f429i_disc1_utils/unit_test_runner.py",
    tags = ["manual"],
    deps = [
        ":stm32f429i_disc1_utils",
    ],
)

pw_py_binary(
    name = "unit_test_server",
    srcs = [
        "stm32f429i_disc1_utils/unit_test_server.py",
    ],
    data = [
        ":unit_test_runner",
        "//pw_target_runner/go/cmd:server",
    ],
    main = "stm32f429i_disc1_utils/unit_test_server.py",
    tags = ["manual"],
    deps = [
        ":stm32f429i_disc1_utils",
        "@rules_python//python/runfiles",
    ],
)

pw_py_binary(
    name = "_unit_test_client",
    srcs = [
        "stm32f429i_disc1_utils/unit_test_client.py",
    ],
    data = ["//pw_target_runner/go/cmd:client"],
    main = "stm32f429i_disc1_utils/unit_test_client.py",
    tags = ["manual"],
    deps = [
        ":stm32f429i_disc1_utils",
        "@rules_python//python/runfiles",
    ],
)

platform_data(
    name = "unit_test_client",
    platform = "@bazel_tools//tools:host_platform",
    target = ":_unit_test_client",
)
