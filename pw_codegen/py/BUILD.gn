import("//build_overrides/pigweed.gni")

import("$dir_pw_build/python.gni")

pw_python_package("py") {
  setup = [
    "pyproject.toml",
    "setup.cfg",
  ]
  sources = [
    "pw_codegen/__init__.py",
    "pw_codegen/cpp.py",
    "pw_codegen/java.py",
    "pw_codegen/output_file.py",
    "pw_codegen/py.typed",
    "pw_codegen/python.py",
    "pw_codegen/rust.py",
    "pw_codegen/typescript.py",
  ]
  tests = [
    "codegen_test.py",
    "cpp_test.py",
    "java_test.py",
    "output_file_test.py",
    "python_test.py",
    "rust_test.py",
    "typescript_test.py",
  ]
  pylintrc = "$dir_pigweed/.pylintrc"
  mypy_ini = "$dir_pigweed/.mypy.ini"
  ruff_toml = "$dir_pigweed/.ruff.toml"
}
