load("//pw_build:python.bzl", "pw_py_library", "pw_py_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

pw_py_library(
    name = "pw_codegen",
    srcs = [
        "pw_codegen/__init__.py",
        "pw_codegen/cpp.py",
        "pw_codegen/java.py",
        "pw_codegen/output_file.py",
        "pw_codegen/python.py",
        "pw_codegen/rust.py",
        "pw_codegen/typescript.py",
    ],
    data = ["pw_codegen/py.typed"],
    imports = ["."],
)

pw_py_test(
    name = "codegen_test",
    size = "small",
    srcs = ["codegen_test.py"],
    deps = [":pw_codegen"],
)

pw_py_test(
    name = "cpp_test",
    size = "small",
    srcs = ["cpp_test.py"],
    deps = [":pw_codegen"],
)

pw_py_test(
    name = "java_test",
    size = "small",
    srcs = ["java_test.py"],
    deps = [":pw_codegen"],
)

pw_py_test(
    name = "output_file_test",
    size = "small",
    srcs = ["output_file_test.py"],
    deps = [":pw_codegen"],
)

pw_py_test(
    name = "python_test",
    size = "small",
    srcs = ["python_test.py"],
    deps = [":pw_codegen"],
)

pw_py_test(
    name = "rust_test",
    size = "small",
    srcs = ["rust_test.py"],
    deps = [":pw_codegen"],
)

pw_py_test(
    name = "typescript_test",
    size = "small",
    srcs = ["typescript_test.py"],
    deps = [":pw_codegen"],
)
