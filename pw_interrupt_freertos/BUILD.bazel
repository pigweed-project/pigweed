load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@sphinxdocs//sphinxdocs:sphinx_docs_library.bzl", "sphinx_docs_library")
load("//pw_build:compatibility.bzl", "boolean_constraint_value", "incompatible_with_mcu")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

# TODO: https://pwbug.dev/347998044 - Remove this once all downstream projects use :compatible.
constraint_value(
    name = "backend",
    constraint_setting = "//pw_interrupt:backend_constraint_setting",
)

boolean_constraint_value(
    name = "compatible",
)

# TODO: https://pwbug.dev/347998044 - This alias will be removed along with the
# multiplexer.
alias(
    name = "impl",
    actual = ":context",
)

cc_library(
    name = "context",
    hdrs = [
        "public_overrides/pw_interrupt_backend/context_inline.h",
    ],
    strip_include_prefix = "public_overrides",
    target_compatible_with = selects.with_or({
        (
            ":compatible",
            ":backend",
        ): [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":context_implementation",
        "//pw_interrupt:context.facade",
    ],
)

cc_library(
    name = "context_implementation",
    hdrs = [
        "public/pw_interrupt_freertos/context_inline.h",
    ],
    strip_include_prefix = "public",
    tags = ["noclangtidy"],
    visibility = ["//visibility:private"],
    deps = [
        "@freertos",
    ],
)

sphinx_docs_library(
    name = "docs",
    srcs = [
        "docs.rst",
    ],
    prefix = "pw_interrupt_freertos/",
    target_compatible_with = incompatible_with_mcu(),
)
