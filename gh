# Wrapper script to run gh-ish with prebuilt caching by Git commit hash.
#
# If the current Git commit hash matches the saved hash of the prebuilt binary,
# it executes the prebuilt directly with zero Bazel startup overhead. If the hash
# changed or the prebuilt does not exist, it builds //pw_ghish:gh-ish via
# bazelisk and caches the resulting binary.
#
# Without Bazel build files or bazelisk (e.g. a copy of this script in a
# repository that does not include Pigweed, with no bootstrapped environment),
# it instead fetches the CIPD prebuilt using the `cipd` client from PATH.

set -e

# Resolve the directory containing this script using pure Bash parameter
# expansion when invoked as a non-symlinked path (e.g. `./gh`) to avoid
# spawning `dirname` and `readlink` subshells on the warm fast-path.
if [ -n "$BASH" ] && [ ! -L "${BASH_SOURCE[0]}" ]; then
  case "${BASH_SOURCE[0]}" in
    ./gh | gh) _PW_SCRIPT_DIR="$PWD" ;;
    */*)
      _PW_SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
      case "$_PW_SCRIPT_DIR" in
        /*)
          case "$_PW_SCRIPT_DIR" in
            */.* | */..) _PW_SCRIPT_DIR="$(cd "$_PW_SCRIPT_DIR" && pwd)" ;;
          esac
          ;;
        .) _PW_SCRIPT_DIR="$PWD" ;;
        *) _PW_SCRIPT_DIR="$(cd "$_PW_SCRIPT_DIR" && pwd)" ;;
      esac
      ;;
    *) _PW_SCRIPT_DIR="$PWD" ;;
  esac
elif test -n "$BASH"; then
  _PW_SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
elif test -n "$ZSH_NAME"; then
  _PW_SCRIPT_DIR="${0:A:h}"
else
  _PW_SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
fi
declare -r _PW_SCRIPT_DIR

export BAZELISK_SKIP_WRAPPER=1

# Resolve the repository paths and the content hashes of pw_ghish/ and
# MODULE.bazel.lock in a single lock-free `git rev-parse` call. The combined
# hash is compared against `out/gh/git_hash` (written after each build) to
# detect when the cached `out/gh/gh-ish` binary needs to be rebuilt.
{ read -r _SCRIPT_TOP; read -r _COMMON_GIT_DIR; read -r _TREE_HASH; read -r _LOCK_HASH; } < <(
  GIT_CONFIG_NOSYSTEM=1 GIT_OPTIONAL_LOCKS=0 \
  git -C "$_PW_SCRIPT_DIR" rev-parse \
    --show-toplevel \
    --path-format=absolute --git-common-dir \
    HEAD:pw_ghish HEAD:MODULE.bazel.lock 2>/dev/null || true
)
_MAIN_REPO_DIR=""
if [ -n "$_COMMON_GIT_DIR" ]; then
  _MAIN_REPO_DIR=$(dirname "$_COMMON_GIT_DIR")
fi
if [ "$PWD" = "$_PW_SCRIPT_DIR" ] || [ "$PWD" -ef "$_PW_SCRIPT_DIR" ] || { [[ "$PWD" == "${_PW_SCRIPT_DIR}/"* ]] && [ ! -e "$PWD/.git" ]; }; then
  _CALLER_TOPLEVEL="$_SCRIPT_TOP"
else
  _CALLER_TOPLEVEL=$(GIT_CONFIG_NOSYSTEM=1 GIT_OPTIONAL_LOCKS=0 git rev-parse --show-toplevel 2>/dev/null || true)
fi
_CURRENT_HASH=""
if [ -n "$_TREE_HASH" ] && [ -n "$_LOCK_HASH" ]; then
  _CURRENT_HASH="${_TREE_HASH}:${_LOCK_HASH}:"
fi

if [ -d "${_PW_SCRIPT_DIR}/environment/cipd/packages/bazelisk" ]; then
  export PATH="${_PW_SCRIPT_DIR}/environment/cipd/packages/bazelisk:${PATH}"
elif [ -n "$_MAIN_REPO_DIR" ] && [ -d "${_MAIN_REPO_DIR}/environment/cipd/packages/bazelisk" ]; then
  export PATH="${_MAIN_REPO_DIR}/environment/cipd/packages/bazelisk:${PATH}"
elif [ -n "$_CALLER_TOPLEVEL" ] && [ -d "${_CALLER_TOPLEVEL}/environment/cipd/packages/bazelisk" ]; then
  export PATH="${_CALLER_TOPLEVEL}/environment/cipd/packages/bazelisk:${PATH}"
elif ! command -v bazelisk >/dev/null 2>&1 && [ -d "$HOME/bin" ]; then
  export PATH="$HOME/bin:${PATH}"
fi
if [ -d "${_PW_SCRIPT_DIR}/environment/cipd/packages/luci" ]; then
  export PATH="${_PW_SCRIPT_DIR}/environment/cipd/packages/luci:${PATH}"
elif [ -n "$_MAIN_REPO_DIR" ] && [ -d "${_MAIN_REPO_DIR}/environment/cipd/packages/luci" ]; then
  export PATH="${_MAIN_REPO_DIR}/environment/cipd/packages/luci:${PATH}"
elif [ -n "$_CALLER_TOPLEVEL" ] && [ -d "${_CALLER_TOPLEVEL}/environment/cipd/packages/luci" ]; then
  export PATH="${_CALLER_TOPLEVEL}/environment/cipd/packages/luci:${PATH}"
elif [ -n "${PW_ENVIRONMENT_ROOT:-}" ] && [ -d "${PW_ENVIRONMENT_ROOT}/cipd/packages/luci" ]; then
  export PATH="${PW_ENVIRONMENT_ROOT}/cipd/packages/luci:${PATH}"
fi

# Internal handoff to the binary, which passes its environment to every
# subprocess, including git hooks run by `./gh pr create`. Pigweed's
# environment parser rejects unrecognized PW_ variables there. This is not a
# Pigweed setting, so rather than registering it with that parser, it uses the
# _PW_ prefix for internal variables, which the parser does not check.
export _PW_GH_SCRIPT_DIR="${_PW_SCRIPT_DIR}"
if [ -z "${BUILD_WORKSPACE_DIRECTORY:-}" ]; then
  if [ -n "$_CALLER_TOPLEVEL" ]; then
    export BUILD_WORKSPACE_DIRECTORY="$_CALLER_TOPLEVEL"
  else
    export BUILD_WORKSPACE_DIRECTORY="$PWD"
  fi
fi
export BUILD_WORKING_DIRECTORY="${PWD}"

# When invoked from a downstream superproject (e.g. via a `gh -> pigweed/gh`
# symlink) or when PW_GH_USE_CIPD is set, prefer the CIPD prebuilt binary so
# downstream GN/CMake projects do not pay a Bazel + Go toolchain build penalty.
if [ -z "${PW_GH_FORCE_BUILD:-}" ] && { [ -n "${PW_GH_USE_CIPD:-}" ] || { [ -n "$_CALLER_TOPLEVEL" ] && [ "$_CALLER_TOPLEVEL" != "$_PW_SCRIPT_DIR" ] && [ ! "$_CALLER_TOPLEVEL" -ef "$_PW_SCRIPT_DIR" ]; }; }; then
  for _CIPD_GH in \
    "${PW_GH_BIN:-}" \
    "${PW_ENVIRONMENT_ROOT:-}/cipd/packages/pigweed/gh-ish" \
    "${PW_ENVIRONMENT_ROOT:-}/cipd/packages/ghish/gh-ish" \
    "${_CALLER_TOPLEVEL}/environment/cipd/packages/pigweed/gh-ish" \
    "${_CALLER_TOPLEVEL}/environment/cipd/packages/ghish/gh-ish" \
    "${_CALLER_TOPLEVEL}/.environment/cipd/packages/pigweed/gh-ish"; do
    if [ -n "$_CIPD_GH" ] && [ -x "$_CIPD_GH" ]; then
      exec "$_CIPD_GH" "$@"
    fi
  done
fi

# Prebuilt cache directory (defaults to out/gh, which is .gitignored in Pigweed).
declare -r _GH_DIR="${_PW_GH_OUT_DIR:-${_PW_SCRIPT_DIR}/out/gh}"
declare -r _GH_BIN="${_GH_DIR}/gh-ish"
declare -r _GH_HASH_FILE="${_GH_DIR}/git_hash"

# Run the cached binary directly when pw_ghish and its dependencies have not
# changed since the last build, avoiding Bazel startup overhead. Documentation
# edits under pw_ghish/ are ignored since they do not affect the binary.
if [ -z "${PW_GH_FORCE_BUILD:-}" ] && [ -x "$_GH_BIN" ] && [ -f "$_GH_HASH_FILE" ] && [ -n "$_CURRENT_HASH" ]; then
  read -r _SAVED_HASH < "$_GH_HASH_FILE" 2>/dev/null || true
  if [ "$_CURRENT_HASH" = "$_SAVED_HASH" ] &&
     GIT_CONFIG_NOSYSTEM=1 GIT_OPTIONAL_LOCKS=0 \
     git -C "$_PW_SCRIPT_DIR" diff-index --quiet HEAD -- \
       pw_ghish ':(exclude)*.md' ':(exclude)*.rst' 2>/dev/null; then
    exec "$_GH_BIN" "$@"
  fi
fi

# Building gh-ish from source requires a Pigweed checkout with Bazel build files
# and bazelisk.
_pw_gh_can_build() {
  [ -f "${_PW_SCRIPT_DIR}/MODULE.bazel" ] &&
    [ -f "${_PW_SCRIPT_DIR}/pw_ghish/BUILD.bazel" ] &&
    command -v bazelisk >/dev/null 2>&1
}

_pw_gh_cipd_platform() {
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) echo "linux-amd64" ;;
    Darwin-arm64) echo "mac-arm64" ;;
    *) return 1 ;;
  esac
}

# Fetches the gh-ish CIPD prebuilt into a per-user cache using the `cipd` client
# from PATH and executes it. Used when there is neither a bootstrapped
# environment nor a way to build from source (e.g. a copy of this script checked
# into a repository that does not include Pigweed). The package is re-resolved
# at most once a day, or immediately when PW_GH_CIPD_VERSION changes.
_pw_gh_exec_cipd() {
  if ! command -v cipd >/dev/null 2>&1; then
    echo "Error: cannot run gh-ish: building it requires bazelisk and Pigweed's" \
      "Bazel build files, and 'cipd' is not on PATH to fetch a prebuilt." >&2
    exit 1
  fi
  local platform
  if ! platform=$(_pw_gh_cipd_platform); then
    echo "Error: no gh-ish CIPD prebuilt for $(uname -s)-$(uname -m)" \
      "(available: linux-amd64, mac-arm64)." >&2
    exit 1
  fi
  local want="pigweed/ghish/${platform} ${PW_GH_CIPD_VERSION:-latest}"
  local root="${PW_GH_CIPD_ROOT:-${XDG_CACHE_HOME:-${HOME}/.cache}/pigweed/gh/cipd}/${platform}"
  local bin="${root}/gh-ish"
  local stamp="${root}/.pw_gh_ensured"

  local now="${EPOCHSECONDS:-$(date +%s)}"
  local mtime
  mtime=$(stat -c %Y "$stamp" 2>/dev/null || stat -f %m "$stamp" 2>/dev/null || echo 0)
  if [ ! -x "$bin" ] ||
    [ "$(cat "$stamp" 2>/dev/null || true)" != "$want" ] ||
    [ $((now - mtime)) -gt 86400 ]; then
    mkdir -p "$root"
    if [ -t 2 ]; then
      printf " ⏱  Fetching %s from CIPD...\n" "$want" >&2
    fi
    if printf '%s\n' "$want" |
      cipd ensure -root "$root" -ensure-file - -log-level warning >/dev/null; then
      printf '%s\n' "$want" >"$stamp"
    elif [ -x "$bin" ]; then
      echo "Warning: failed to update ${want} from CIPD; using cached ${bin}." >&2
      # Back off for a day instead of retrying (e.g. while offline) every run.
      touch "$stamp" 2>/dev/null || true
    else
      echo "Error: failed to fetch ${want} from CIPD." >&2
      exit 1
    fi
  fi
  exec "$bin" "$@"
}

if [ -z "$_CURRENT_HASH" ]; then
  _CURRENT_HASH=$(GIT_CONFIG_NOSYSTEM=1 GIT_OPTIONAL_LOCKS=0 git -C "$_PW_SCRIPT_DIR" rev-parse HEAD 2>/dev/null || true)
fi
if [ -z "$_CURRENT_HASH" ] && [ -n "${PW_GH_DEBUG:-}" ]; then
  echo "Warning: git rev-parse HEAD failed in $_PW_SCRIPT_DIR; caching disabled." >&2
fi

_STALE=1
_DIRTY=$(GIT_CONFIG_NOSYSTEM=1 GIT_OPTIONAL_LOCKS=0 git -C "$_PW_SCRIPT_DIR" status --porcelain -- pw_ghish ':(exclude)*.md' ':(exclude)*.rst' 2>/dev/null || true)
if [ -z "${PW_GH_FORCE_BUILD:-}" ] && [ -z "$_DIRTY" ] && [ -n "$_CURRENT_HASH" ]; then
  if [ -f "$_GH_BIN" ] && [ -f "$_GH_HASH_FILE" ]; then
    _SAVED_HASH=$(cat "$_GH_HASH_FILE" 2>/dev/null || true)
    if [ "$_CURRENT_HASH" = "$_SAVED_HASH" ]; then
      _STALE=0
    fi
  fi
  if [ $_STALE -eq 1 ] && [ -n "$_MAIN_REPO_DIR" ] && [ "$_MAIN_REPO_DIR" != "$_PW_SCRIPT_DIR" ] && [ ! "$_MAIN_REPO_DIR" -ef "$_PW_SCRIPT_DIR" ]; then
    if [ -f "${_MAIN_REPO_DIR}/out/gh/gh-ish" ] && [ -f "${_MAIN_REPO_DIR}/out/gh/git_hash" ]; then
      _MAIN_SAVED_HASH=$(cat "${_MAIN_REPO_DIR}/out/gh/git_hash" 2>/dev/null || true)
      if [ "$_CURRENT_HASH" = "$_MAIN_SAVED_HASH" ]; then
        mkdir -p "$_GH_DIR"
        cp -f "${_MAIN_REPO_DIR}/out/gh/gh-ish" "$_GH_BIN"
        chmod +x "$_GH_BIN"
        echo "$_CURRENT_HASH" > "$_GH_HASH_FILE"
        _STALE=0
      fi
    fi
  fi
fi

if [ $_STALE -eq 1 ] && [ -z "${PW_GH_FORCE_BUILD:-}" ] && ! _pw_gh_can_build; then
  _pw_gh_exec_cipd "$@"
fi

if [ $_STALE -eq 1 ]; then
  # Build chatter never goes to stdout, and reaches stderr only when stderr is
  # a terminal. When stderr is a pipe (`./gh wt close p 2>&1 | head -1`),
  # Bazel's "INFO:" lines would be the first thing the reader sees; once it
  # exits, Bazel's next write fails, the build "fails", and `set -e` aborts
  # here before the requested command ever runs. Capture the output instead
  # and replay it only if the build really fails.
  if [ -t 2 ]; then
    if [ -n "$_DIRTY" ]; then
      printf " ⏱  Building gh-ish (local uncommitted changes in pw_ghish)...\n" >&2
    else
      printf " ⏱  Building gh-ish (commit %.8s)...\n" "${_CURRENT_HASH:-unknown}" >&2
    fi
  fi

  _LOCK_DIRTY=$(GIT_CONFIG_NOSYSTEM=1 GIT_OPTIONAL_LOCKS=0 git -C "$_PW_SCRIPT_DIR" status --porcelain -- MODULE.bazel.lock 2>/dev/null || true)
  _BUILD_STATUS=0
  _BUILD_LOG=""
  _pw_gh_cleanup_build() {
    if [ -n "$_BUILD_LOG" ]; then
      rm -f "$_BUILD_LOG"
    fi
    if [ -z "$_LOCK_DIRTY" ]; then
      git -C "$_PW_SCRIPT_DIR" checkout -- MODULE.bazel.lock 2>/dev/null || true
    fi
  }
  # Clean up the log and restore MODULE.bazel.lock however the build ends.
  # INT/TERM exit through the EXIT trap; the traps are cleared before `exec`,
  # which skips them anyway.
  trap '_pw_gh_cleanup_build' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  if [ ! -t 2 ]; then
    mkdir -p "$_GH_DIR"
    _BUILD_LOG="${_GH_DIR}/build.$$.log"
    exec 3>"$_BUILD_LOG"
  else
    exec 3>&2
  fi
  (
    cd "$_PW_SCRIPT_DIR"
    bazelisk build \
      --noshow_progress \
      --noshow_loading_progress \
      //pw_ghish:gh-ish
  ) >&3 2>&3 || _BUILD_STATUS=$?
  exec 3>&-
  if [ "$_BUILD_STATUS" -ne 0 ]; then
    # Report from subshells: if stderr is a closed pipe, SIGPIPE kills only
    # the subshell, so the build's own status still reaches the caller.
    if [ -n "$_BUILD_LOG" ]; then
      (cat "$_BUILD_LOG" >&2) || :
    fi
    (echo "Error: failed to build //pw_ghish:gh-ish (exit ${_BUILD_STATUS})." >&2) || :
    exit "$_BUILD_STATUS"
  fi
  _pw_gh_cleanup_build
  trap - EXIT INT TERM

  _BUILT_BIN="${_PW_SCRIPT_DIR}/bazel-bin/pw_ghish/gh-ish_/gh-ish"
  if [ ! -f "$_BUILT_BIN" ]; then
    _BUILT_BIN="${_PW_SCRIPT_DIR}/bazel-bin/pw_ghish/gh-ish"
  fi
  if [ ! -f "$_BUILT_BIN" ]; then
    echo "Error: built binary not found at $_BUILT_BIN" >&2
    exit 1
  fi

  mkdir -p "$_GH_DIR"
  cp -f "$_BUILT_BIN" "$_GH_BIN"
  chmod +x "$_GH_BIN"
  if [ -n "$_CURRENT_HASH" ] && [ -z "$_DIRTY" ]; then
    echo "$_CURRENT_HASH" > "$_GH_HASH_FILE"
  else
    rm -f "$_GH_HASH_FILE"
  fi
fi

exec "$_GH_BIN" "$@"
