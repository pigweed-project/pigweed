load("//pw_build:pw_cc_binary.bzl", "pw_cc_binary")
load("//pw_build:python.bzl", "pw_py_binary")

package(default_visibility = ["//:__subpackages__"])

licenses(["notice"])

# The framed TCP transport uses POSIX sockets.
hosts_lin_mac = {
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
}

pw_cc_binary(
    name = "server",
    srcs = ["server.cc"],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        "//pw_allocator",
        "//pw_allocator:libc_allocator",
        "//pw_async2",
        "//pw_async2:basic_dispatcher",
        "//pw_buf",
        "//pw_log",
        "//pw_result",
        "//pw_string:builder",
        "//pw_transport/cpp:framed_tcp",
        "//pw_transport/cpp:pw_transport",
    ],
)

pw_cc_binary(
    name = "client",
    srcs = ["client.cc"],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        "//pw_allocator",
        "//pw_allocator:libc_allocator",
        "//pw_async2",
        "//pw_async2:basic_dispatcher",
        "//pw_async2:system_time_provider",
        "//pw_async2:time_provider",
        "//pw_buf",
        "//pw_chrono:system_clock",
        "//pw_log",
        "//pw_result",
        "//pw_string:builder",
        "//pw_transport/cpp:framed_tcp",
        "//pw_transport/cpp:pw_transport",
    ],
)

pw_py_binary(
    name = "run_harness",
    srcs = ["run_harness.py"],
    data = [
        ":client",
        ":server",
    ],
    target_compatible_with = select(hosts_lin_mac),
    deps = [
        "@rules_python//python/runfiles",
    ],
)
