{# GN build file helper macros. Unlike Starlark arguments, GN assignments
   are not separated by commas, so a list must not be followed by one. #}

{% macro string_list(items) -%}
{% if not items %}
[]
{%- elif items|length == 1 %}
[ "{{ items|first }}" ]
{%- else %}
[
{% for item in items|sort %}
    "{{ item }}",
{% endfor %}
  ]
{%- endif %}
{%- endmacro -%}

{% macro file_list(build, files) -%}
{% set relative_files = [] %}
{% for file in files %}
{% do relative_files.append(build.relative_file(file)) %}
{% endfor %}
{{ string_list(relative_files) }}
{%- endmacro -%}

{% macro deps_list(deps) -%}
{{ string_list(deps) }}
{%- endmacro -%}
