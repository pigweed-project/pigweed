load("//pw_build:pw_ts.bzl", "pw_ts_library", "pw_ts_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

pw_ts_library(
    name = "js_files",
    srcs = [
        "client.ts",
        "index.ts",
        "transfer.ts",
        "//pw_transfer:js_protos",
    ],
    deps = [
        "//pw_rpc/ts:js_files",
        "//pw_status/ts:js_files",
        "//pw_web:protos_lib",
    ],
)

pw_ts_test(
    name = "transfer_test",
    srcs = ["transfer_test.ts"],
    deps = [":js_files"],
)
