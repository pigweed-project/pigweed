package {
    default_applicable_licenses: ["external_pigweed_license"],
}

filegroup {
    name: "pw_transfer_core_src_files",
    srcs: [
        "chunk.cc",
        "client_context.cc",
        "context.cc",
        "rate_estimate.cc",
        "server_context.cc",
        "transfer_thread.cc",
    ],
}

filegroup {
    name: "pw_transfer_client_src_files",
    srcs: [
        "client.cc",
    ],
}

filegroup {
    name: "pw_transfer_service_src_files",
    srcs: [
        "transfer.cc",
    ],
}

// Do not use this directly. It is used by the pw_transfer defaults to keep the
// path to the "public" directory relative to this module.
cc_library_headers {
    name: "pw_transfer_include_dirs",
    export_include_dirs: [
        "public",
    ],
    vendor_available: true,
    host_supported: true,
}

// This rule must be instantiated, i.e.
//
//   cc_library_static {
//       name: "pw_transfer_<instance_name>",
//       defaults: [
//           "pw_rpc_cflags_<instance_name>",
//           "pw_transfer_core_defaults",
//           "pw_transfer_client_defaults",
//       ],
//   }
//
// where pw_rpc_cflags_<instance_name> defines the same pw_rpc flags as the
// rest of the binary. pw_transfer_core compiles pw_rpc through
// pw_rpc_defaults, so every pw_rpc user in a binary must use the same flags.
//
// Add pw_transfer_client_defaults and/or pw_transfer_service_defaults to the
// same instance to include the client and/or the transfer service.
//
// see pw_rpc_defaults
cc_defaults {
    name: "pw_transfer_core_defaults",
    cpp_std: "c++20",
    defaults: [
        "pw_android_common_backends",
        "pw_rpc_raw_defaults",
        "pw_rpc_defaults",
    ],
    srcs: [
        ":pw_transfer_core_src_files",
    ],
    header_libs: [
        "pw_assert",
        "pw_chrono",
        "pw_log",
        "pw_sync",
        "pw_transfer_include_dirs",
        "pw_transfer_raw_rpc",
        "pw_transfer_pwpb",
    ],
    export_header_lib_headers: [
        "pw_transfer_include_dirs",
        "pw_transfer_raw_rpc",
        "pw_transfer_pwpb",
    ],
    static_libs: [
        "pw_containers",
        "pw_preprocessor",
        "pw_protobuf",
        "pw_result",
        "pw_span",
        "pw_status",
        "pw_stream",
        "pw_thread",
        "pw_varint",
    ],
    whole_static_libs: [
        "pw_log_rate_limited",
        "pw_sync.binary_semaphore_thread_notification",
    ],
}

// Client sources. Must be instantiated together with
// pw_transfer_core_defaults; see pw_transfer_core_defaults.
cc_defaults {
    name: "pw_transfer_client_defaults",
    defaults: [
        "pw_android_common_backends",
    ],
    srcs: [
        ":pw_transfer_client_src_files",
    ],
    header_libs: [
        "pw_transfer_include_dirs",
    ],
    export_header_lib_headers: [
        "pw_transfer_include_dirs",
    ],
    static_libs: [
        "pw_function",
        "pw_stream",
    ],
}

// Transfer service sources. Must be instantiated together with
// pw_transfer_core_defaults; see pw_transfer_core_defaults.
cc_defaults {
    name: "pw_transfer_service_defaults",
    defaults: [
        "pw_android_common_backends",
    ],
    srcs: [
        ":pw_transfer_service_src_files",
    ],
    header_libs: [
        "pw_transfer_include_dirs",
    ],
    export_header_lib_headers: [
        "pw_transfer_include_dirs",
    ],
    static_libs: [
        "pw_bytes",
        "pw_result",
        "pw_status",
        "pw_stream",
    ],
}

// Deprecated: pw_transfer_core, pw_transfer, and pw_transfer_client build
// pw_rpc with the default pw_rpc flags. Linking them into a binary that uses
// other pw_rpc flags violates the ODR. Instantiate pw_transfer_core_defaults
// with your pw_rpc flags instead.
cc_library_static {
    name: "pw_transfer_core",
    vendor_available: true,
    host_supported: true,
    defaults: [
        "pw_transfer_core_defaults",
    ],
}

// Deprecated: see pw_transfer_core.
cc_library_static {
    name: "pw_transfer",
    vendor_available: true,
    host_supported: true,
    defaults: [
        "pw_transfer_service_defaults",
    ],
    static_libs: [
        "pw_transfer_core",
    ],
}

// Deprecated: see pw_transfer_core.
cc_library_static {
    name: "pw_transfer_client",
    vendor_available: true,
    host_supported: true,
    defaults: [
        "pw_transfer_client_defaults",
    ],
    static_libs: [
        "pw_transfer_core",
    ],
}

genrule {
    name: "pw_transfer_proto_with_prefix",
    defaults: ["pw_rpc_add_prefix_to_proto"],
    srcs: ["transfer.proto"],
    out: ["pw_transfer/transfer.proto"],
}

genrule {
    name: "pw_transfer_raw_rpc_header",
    defaults: ["pw_rpc_generate_raw_rpc_header_with_prefix"],
    srcs: [":pw_transfer_proto_with_prefix"],
    out: ["pw_transfer/transfer.raw_rpc.pb.h"],
}

genrule {
    name: "pw_transfer_pwpb_rpc_header",
    defaults: ["pw_rpc_generate_pwpb_rpc_header_with_prefix"],
    srcs: [":pw_transfer_proto_with_prefix"],
    out: ["pw_transfer/transfer.rpc.pwpb.h"],
}

genrule {
    name: "pw_transfer_pwpb_proto_header",
    defaults: ["pw_rpc_generate_pwpb_proto_with_prefix"],
    srcs: [":pw_transfer_proto_with_prefix"],
    out: ["pw_transfer/transfer.pwpb.h"],
}

cc_library_headers {
    name: "pw_transfer_pwpb",
    cpp_std: "c++20",
    vendor_available: true,
    host_supported: true,
    generated_headers: [
        "pw_transfer_pwpb_proto_header",
        "pw_transfer_pwpb_rpc_header",
    ],
    export_generated_headers: [
        "pw_transfer_pwpb_proto_header",
        "pw_transfer_pwpb_rpc_header",
    ],
}

cc_library_headers {
    name: "pw_transfer_raw_rpc",
    cpp_std: "c++20",
    vendor_available: true,
    host_supported: true,
    generated_headers: [
        "pw_transfer_raw_rpc_header",
    ],
    export_generated_headers: [
        "pw_transfer_raw_rpc_header",
    ],
}
