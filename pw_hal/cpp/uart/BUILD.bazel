load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//sphinxdocs:sphinx_docs_library.bzl", "sphinx_docs_library")
load("//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")

package(
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

cc_library(
    name = "uart_driver",
    hdrs = [
        "public/pw_hal/uart/uart_driver.h",
    ],
    strip_include_prefix = "public",
    deps = [
        "//pw_buf",
        "//pw_function",
        "//pw_span",
        "//pw_status",
    ],
)

cc_library(
    name = "sync_uart",
    srcs = [
        "sync_uart.cc",
    ],
    hdrs = [
        "public/pw_hal/uart/sync_uart.h",
    ],
    strip_include_prefix = "public",
    deps = [
        ":uart_driver",
        "//pw_assert:assert",
        "//pw_bytes",
        "//pw_chrono:system_clock",
        "//pw_status",
        "//pw_sync:timed_mutex",
        "//pw_sync:timed_thread_notification",
    ],
)

cc_library(
    name = "buffered_uart_driver_gmock",
    testonly = True,
    srcs = [
        "buffered_uart_driver_gmock.cc",
    ],
    hdrs = [
        "public/pw_hal/uart/buffered_uart_driver_gmock.h",
    ],
    strip_include_prefix = "public",
    target_compatible_with = incompatible_with_mcu(),
    deps = [
        ":uart_driver",
        "//pw_function",
        "//pw_span",
        "//pw_status",
        "@com_google_googletest//:gtest",
    ],
)

pw_cc_test(
    name = "sync_uart_test",
    srcs = [
        "sync_uart_test.cc",
    ],
    target_compatible_with = select({
        "//pw_unit_test:backend_is_googletest": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":buffered_uart_driver_gmock",
        ":sync_uart",
        "//pw_bytes",
        "//pw_chrono:system_clock",
        "//pw_status",
        "//pw_thread:sleep",
        "//pw_thread:test_thread_context",
        "//pw_thread:thread",
        "@com_google_googletest//:gtest",
    ],
)

filegroup(
    name = "doxygen",
    srcs = [
        "public/pw_hal/uart/uart_driver.h",
    ],
)

sphinx_docs_library(
    name = "docs",
    srcs = [
        "docs.rst",
    ],
    prefix = "uart/",
    target_compatible_with = incompatible_with_mcu(),
)
