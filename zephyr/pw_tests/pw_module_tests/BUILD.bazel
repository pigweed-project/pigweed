load("@pigweed//zephyr:pw_module_tests.bzl", "ZEPHYR_PW_MODULE_TESTS")
load("@zephyr//:cc.bzl", "zephyr_cc_library")
load(":native_sim_cc_unit_test.bzl", "generate_module_tests")

zephyr_cc_library(
    name = "main",
    testonly = True,
    srcs = ["main.cc"],
    target_compatible_with = [
        "@zephyr//boards:sim",
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    deps = [
        "@pigweed//pw_unit_test",
        "@pigweed//pw_unit_test:printf_event_handler",
        "@zephyr//scripts/native_simulator",
    ],
)

_MODULE_TESTS_TARGETS = generate_module_tests(ZEPHYR_PW_MODULE_TESTS)

test_suite(
    name = "pw_module_tests",
    tests = _MODULE_TESTS_TARGETS,
)
