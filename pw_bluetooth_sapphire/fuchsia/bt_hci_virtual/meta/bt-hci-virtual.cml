{
    // No inspect shard: bt_hci_virtual does not use Inspect, and the SDK's
    // inspect shard would add a required `use` of fuchsia.inspect.InspectSink.
    include: [ "syslog/client.shard.cml" ],
    program: {
        runner: "elf",
        binary: "bin/bt_hci_virtual",
        forward_stderr_to: "log",
        forward_stdout_to: "log",
    },
    capabilities: [
        // One instance per VirtualController (this component): "default".
        { service: "fuchsia.hardware.bluetooth.VirtualControllerService" },

        // One instance per live emulator (added/removed dynamically).
        { service: "fuchsia.hardware.bluetooth.EmulatorService" },

        // One instance per *published* emulator or loopback device; this is
        // what bt-init watches to spawn bt-host.
        { service: "fuchsia.hardware.bluetooth.Service" },
    ],
    expose: [
        {
            service: [
                "fuchsia.hardware.bluetooth.EmulatorService",
                "fuchsia.hardware.bluetooth.Service",
                "fuchsia.hardware.bluetooth.VirtualControllerService",
            ],
            from: "self",
        },
    ],
}
