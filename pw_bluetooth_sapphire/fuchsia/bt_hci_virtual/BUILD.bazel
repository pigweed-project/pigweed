load("@fuchsia_infra//infra:infra.bzl", "fuchsia_cipd_releases")
load(
    "@rules_fuchsia//fuchsia:defs.bzl",
    "fuchsia_cc_binary",
    "fuchsia_cc_library",
    "fuchsia_cc_test",
    "fuchsia_component",
    "fuchsia_component_manifest",
    "fuchsia_package",
    "fuchsia_platforms",
    "fuchsia_test_component",
    "fuchsia_test_package",
)
load(
    "@rules_fuchsia//fuchsia:licenses.bzl",
    "fuchsia_licenses_collection",
    "fuchsia_licenses_spdx",
)
load("//pw_bluetooth_sapphire/fuchsia:cipd.bzl", "CIPD_ROOT")
load("//pw_bluetooth_sapphire/fuchsia:fuchsia_api_level.bzl", "FUCHSIA_API_LEVEL")

package(default_visibility = ["//visibility:public"])

# The virtual devices and the VirtualController that creates them.
fuchsia_cc_library(
    name = "virtual_sources",
    testonly = True,
    srcs = [
        "emulated_peer.cc",
        "emulator.cc",
        "loopback.cc",
        "virtual_controller.cc",
    ],
    hdrs = [
        "emulated_peer.h",
        "emulator.h",
        "loopback.h",
        "vendor_service_publisher.h",
        "virtual_controller.h",
    ],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        "//pw_assert:check",
        "//pw_async_fuchsia:dispatcher",
        "//pw_bluetooth_sapphire/fuchsia/host/fidl:helpers",
        "//pw_bluetooth_sapphire/host/common",
        "//pw_bluetooth_sapphire/host/testing:fake_controller",
        "//pw_random_fuchsia:zircon_random_generator",
        "@fuchsia_sdk//fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_cpp",
        "@fuchsia_sdk//pkg/async-cpp",
        "@fuchsia_sdk//pkg/component_outgoing_cpp",
        "@fuchsia_sdk//pkg/fidl_cpp",
        "@fuchsia_sdk//pkg/fit",
        "@fuchsia_sdk//pkg/zx",
    ],
)

fuchsia_cc_binary(
    name = "bt_hci_virtual_bin",
    testonly = True,
    srcs = ["main.cc"],
    bin_name = "bt_hci_virtual",
    # TODO: b/367805596 - Remove when dynamic linking size budget issues are resolved.
    features = ["static_cpp_standard_library"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":virtual_sources",
        "//pw_bluetooth_sapphire/host/common",
        "//pw_log_fuchsia",
        "//pw_log_fuchsia:pw_log_fuchsia_syslog",
        "@fuchsia_sdk//pkg/async-loop-cpp",
        "@fuchsia_sdk//pkg/async-loop-default",
        "@fuchsia_sdk//pkg/component_outgoing_cpp",
    ],
)

fuchsia_component_manifest(
    name = "bt_hci_virtual_manifest",
    src = "meta/bt-hci-virtual.cml",
)

fuchsia_component(
    name = "bt_hci_virtual_component",
    testonly = True,
    manifest = ":bt_hci_virtual_manifest",
    deps = [":bt_hci_virtual_bin"],
)

fuchsia_package(
    name = "pkg.x64",
    package_name = "virtual",
    testonly = True,
    components = [":bt_hci_virtual_component"],
    fuchsia_api_level = FUCHSIA_API_LEVEL,
    package_repository_name = "fuchsia.com",
    platform = fuchsia_platforms.x64,
    visibility = ["//visibility:public"],
)

fuchsia_package(
    name = "pkg.x64.repo.disabled",
    package_name = "virtual",
    testonly = True,
    components = [":bt_hci_virtual_component"],
    disable_repository_name = "fuchsia.com",
    fuchsia_api_level = FUCHSIA_API_LEVEL,
    platform = fuchsia_platforms.x64,
    visibility = ["//visibility:public"],
)

fuchsia_package(
    name = "pkg.arm64",
    package_name = "virtual",
    testonly = True,
    components = [":bt_hci_virtual_component"],
    fuchsia_api_level = FUCHSIA_API_LEVEL,
    package_repository_name = "fuchsia.com",
    platform = fuchsia_platforms.arm64,
    visibility = ["//visibility:public"],
)

fuchsia_package(
    name = "pkg.riscv64",
    package_name = "virtual",
    testonly = True,
    components = [":bt_hci_virtual_component"],
    fuchsia_api_level = FUCHSIA_API_LEVEL,
    package_repository_name = "fuchsia.com",
    platform = fuchsia_platforms.riscv64,
    visibility = ["//visibility:public"],
)

fuchsia_cc_test(
    name = "emulator_test",
    srcs = ["emulator_test.cc"],
    visibility = ["//visibility:public"],
    deps = [":outgoing_loop_test_fixture"],
)

fuchsia_cc_test(
    name = "loopback_test",
    srcs = ["loopback_test.cc"],
    visibility = ["//visibility:public"],
    deps = [":outgoing_loop_test_fixture"],
)

fuchsia_cc_library(
    name = "outgoing_loop_test_fixture",
    testonly = True,
    hdrs = ["outgoing_loop_test_fixture.h"],
    target_compatible_with = ["@platforms//os:fuchsia"],
    deps = [
        ":virtual_sources",
        "//pw_bluetooth_sapphire/host/testing:gtest_main",
        "//pw_log_fuchsia:pw_log_fuchsia_syslog",
        "//pw_unit_test",
        "@fuchsia_sdk//fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_cpp",
        "@fuchsia_sdk//fidl/fuchsia.io:fuchsia.io_cpp",
        "@fuchsia_sdk//pkg/async-loop-cpp",
        "@fuchsia_sdk//pkg/async-loop-default",
        "@fuchsia_sdk//pkg/component_incoming_cpp",
        "@fuchsia_sdk//pkg/component_outgoing_cpp",
    ],
)

fuchsia_cc_test(
    name = "virtual_controller_test",
    srcs = ["virtual_controller_test.cc"],
    visibility = ["//visibility:public"],
    deps = [":outgoing_loop_test_fixture"],
)

# Runs bt-hci-virtual.cm, so the test package carries the component and the
# RealmBuilder server its manifest refers to. The binary and component names
# differ so that fuchsia_cc_test's generated manifest cannot clash with
# meta/component_test.cml.
fuchsia_cc_test(
    name = "component_test_bin",
    srcs = ["component_test.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":virtual_sources",
        "//pw_bluetooth_sapphire/host/testing:gtest_main",
        "//pw_unit_test",
        "@fuchsia_sdk//fidl/fuchsia.hardware.bluetooth:fuchsia.hardware.bluetooth_cpp",
        "@fuchsia_sdk//fidl/fuchsia.io:fuchsia.io_cpp",
        "@fuchsia_sdk//pkg/async-loop-cpp",
        "@fuchsia_sdk//pkg/async-loop-default",
        "@fuchsia_sdk//pkg/component_incoming_cpp",
        "@fuchsia_sdk//pkg/sys_component_cpp_testing",
    ],
)

fuchsia_component_manifest(
    name = "component_test_manifest",
    src = "meta/component_test.cml",
)

fuchsia_test_component(
    name = "component_test",
    manifest = ":component_test_manifest",
    deps = [":component_test_bin"],
)

fuchsia_test_package(
    name = "test_pkg",
    package_name = "bt-hci-virtual-unittests",
    components = [":bt_hci_virtual_component"],
    fuchsia_api_level = FUCHSIA_API_LEVEL,
    platform = fuchsia_platforms.x64,
    subpackages = ["@fuchsia_sdk//packages/realm_builder_server"],
    test_components = [
        ":component_test",
        ":emulator_test.unittest_component",
        ":loopback_test.unittest_component",
        ":virtual_controller_test.unittest_component",
    ],
    visibility = ["//visibility:public"],
)

fuchsia_licenses_collection(
