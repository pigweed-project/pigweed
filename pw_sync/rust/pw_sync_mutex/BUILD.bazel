load("@pigweed//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "pw_sync_mutex_core",
    srcs = [
        "pw_sync_mutex_core.rs",
    ],
    edition = "2021",
    deps = [
        "//pw_assert/rust:pw_assert",
        "//pw_time/rust:pw_time",
    ],
)

rust_doc(
    name = "pw_sync_mutex_core_docs",
    crate = ":pw_sync_mutex_core",
    target_compatible_with = incompatible_with_mcu(),
)

rust_doc_test(
    name = "pw_sync_mutex_core_doc_test",
    crate = ":pw_sync_mutex_core",
    target_compatible_with = incompatible_with_mcu(),
)

rust_library(
    name = "pw_sync_mutex",
    srcs = [
        "pw_sync_mutex/_design.rs",
        "pw_sync_mutex/lib.rs",
        "pw_sync_mutex/tests.rs",
    ],
    edition = "2021",
    deps = [
        ":pw_sync_mutex_backend",
        ":pw_sync_mutex_core",
        "//pw_time/rust:pw_time",
    ],
)

rust_doc(
    name = "pw_sync_mutex_docs",
    crate = ":pw_sync_mutex",
    target_compatible_with = incompatible_with_mcu(),
)

rust_doc_test(
    name = "pw_sync_mutex_doc_test",
    crate = ":pw_sync_mutex",
    target_compatible_with = incompatible_with_mcu(),
)

rust_library(
    name = "pw_sync_mutex_backend_std",
    srcs = [
        "pw_sync_mutex_backend_std.rs",
    ],
    crate_name = "pw_sync_mutex_backend",
    edition = "2021",
    target_compatible_with = incompatible_with_mcu(),
    deps = [
        ":pw_sync_mutex_core",
        "//pw_assert/rust:pw_assert",
        "//pw_time/rust:pw_time",
    ],
)

rust_library(
    name = "pw_sync_mutex_backend_freertos",
    srcs = [
        "pw_sync_mutex_backend_freertos.rs",
    ],
    crate_name = "pw_sync_mutex_backend",
    edition = "2021",
    target_compatible_with = ["//pw_build/constraints/rtos:freertos"],
    deps = [
        ":pw_sync_mutex_core",
        "//pw_assert/rust:pw_assert",
        "//pw_time/rust:pw_time",
        "//third_party/freertos/freertos_sys",
    ],
)

rust_library(
    name = "pw_sync_mutex_backend_pigweed",
    srcs = [
        "pw_sync_mutex_backend_pigweed.rs",
    ],
    aliases = {
        "//pw_kernel/target:target_arch": "target_arch",
    },
    crate_name = "pw_sync_mutex_backend",
    edition = "2021",
    target_compatible_with = ["//pw_build/constraints/rtos:pigweed"],
    deps = [
        ":pw_sync_mutex_core",
        "//pw_kernel/kernel",
        "//pw_kernel/target:target_arch",
        "//pw_time/rust:pw_time",
    ],
)

label_flag(
    name = "pw_sync_mutex_backend",
    build_setting_default = ":pw_sync_mutex_backend_std",
)

rust_test(
    name = "pw_sync_mutex_test",
    crate = ":pw_sync_mutex",
    edition = "2021",
    target_compatible_with = incompatible_with_mcu(),
)
