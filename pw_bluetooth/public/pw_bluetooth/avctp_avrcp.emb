# This file contains Emboss packet definitions for the Bluetooth Audio/Video
# Control Transport Protocol (AVCTP) and Audio/Video Remote Control Profile
# (AVRCP) protocols.
#
# References:
# - AVCTP: Audio/Video Control Transport Protocol Specification, Version 1.4
# - AVRCP: Audio/Video Remote Control Profile Specification, Version 1.6.2
# - AV/C: AV/C Digital Interface Command Set General Specification, Version 4.2
#
# NOTE: The definitions below are incomplete. They get added as needed.

[$default byte_order: "BigEndian"]
[(cpp) namespace: "pw::bluetooth::emboss"]


enum AvctpPacketType:
  [maximum_bits: 2]
  SINGLE_PACKET = 0
  START_PACKET  = 1
  CONTINUE      = 2
  END_PACKET    = 3


bits AvctpHeader:
  0 [+1]  Flag             ipid
  1 [+1]  Flag             cr
  2 [+2]  AvctpPacketType  packet_type
  4 [+4]  UInt             transaction_label


bits AvcSubunitAddress:
  0 [+3]  UInt  subunit_id
  3 [+5]  UInt  subunit_type


enum AvcCtype:
  [maximum_bits: 4]
  CONTROL     = 0x00
  STATUS      = 0x01
  SPEC_INQ    = 0x02
  NOTIFY      = 0x03
  GENERAL_INQ = 0x04


enum AvcResponseCode:
  [maximum_bits: 4]
  NOT_IMPLEMENTED = 0x08
  ACCEPTED        = 0x09
  REJECTED        = 0x0A
  IN_TRANSITION   = 0x0B
  IMPLEMENTED     = 0x0C
  CHANGED         = 0x0D
  INTERIM         = 0x0F


enum AvcOpcode:
  [maximum_bits: 8]
  VENDOR_DEPENDENT = 0x00
  UNIT_INFO        = 0x30
  SUBUNIT_INFO     = 0x31
  PASS_THROUGH     = 0x7C


enum AvrcpEventId:
  [maximum_bits: 8]
  PLAYBACK_STATUS_CHANGED            = 0x01
  TRACK_CHANGED                      = 0x02
  TRACK_REACHED_END                  = 0x03
  TRACK_REACHED_START                = 0x04
  PLAYBACK_POS_CHANGED               = 0x05
  BATT_STATUS_CHANGED                = 0x06
  SYSTEM_STATUS_CHANGED              = 0x07
  PLAYER_APPLICATION_SETTING_CHANGED = 0x08
  NOW_PLAYING_CONTENT_CHANGED        = 0x09
  AVAILABLE_PLAYERS_CHANGED          = 0x0A
  ADDRESSED_PLAYER_CHANGED           = 0x0B
  UIDS_CHANGED                       = 0x0C
  VOLUME_CHANGED                     = 0x0D


enum AvrcpPlayStatus:
  [maximum_bits: 8]
  STOPPED  = 0x00
  PLAYING  = 0x01
  PAUSED   = 0x02
  FWD_SEEK = 0x03
  REV_SEEK = 0x04
  ERROR    = 0xFF


enum AvrcpPduId:
  [maximum_bits: 8]
  GET_CAPABILITIES                = 0x10
  LIST_PLAYER_APPLICATION_SETTING = 0x11
  GET_ELEMENT_ATTRIBUTES          = 0x20
  GET_PLAY_STATUS                 = 0x30
  REGISTER_NOTIFICATION           = 0x31
  SET_ABSOLUTE_VOLUME             = 0x50


struct AvcHeader:
  0 [+1]  bits:
    # Bits 0-3 represent a union that is interpreted as ctype in commands and
    # response in responses.
    0 [+4]       AvcCtype           ctype
    0 [+4]       AvcResponseCode    response
    4 [+4]       UInt               reserved

  1 [+1]         AvcSubunitAddress  subunit_address
  2 [+1]         UInt               opcode


struct AvrcpVendorDependentHeader:
  0 [+3]  UInt  company_id
  3 [+1]  UInt  pdu_id


struct AvcFrameHeader:
  0 [+1]  AvctpHeader  avctp_header
  1 [+2]  UInt         profile_id
  3 [+3]  AvcHeader    avc_header


struct AvrcpVendorDependentFrame:
  0 [+1]  AvctpHeader                 avctp_header
  1 [+2]  UInt                        profile_id
  3 [+3]  AvcHeader                   avc_header
  6 [+4]  AvrcpVendorDependentHeader  avrcp_header


struct AvrcpVendorDependentPacket:
  0  [+1]    AvctpHeader                 avctp_header
  1  [+2]    UInt                        profile_id
  3  [+3]    AvcHeader                   avc_header
  6  [+4]    AvrcpVendorDependentHeader  avrcp_header
  10 [+1]    UInt                        packet_type
  11 [+2]    UInt                        parameter_length
  if avrcp_header.pdu_id == 0x31:
    13 [+1]  UInt                        event_id

  if avrcp_header.pdu_id == 0x31 && parameter_length == 2 && event_id == 0x01:
    14 [+1]  AvrcpPlayStatus             playback_status

  if avrcp_header.pdu_id == 0x31 && parameter_length == 5 && event_id == 0x05:
    14 [+4]  UInt                        playback_interval

  if avrcp_header.pdu_id == 0x31 && parameter_length == 2 && event_id == 0x0D:
    14 [+1]  UInt                        volume

  if avrcp_header.pdu_id == 0x50:
    13 [+1]  UInt                        absolute_volume


struct AvrcpVolumeControlPacket:
  0  [+1]    AvctpHeader                 avctp_header
  1  [+2]    UInt                        profile_id
  3  [+3]    AvcHeader                   avc_header
  6  [+4]    AvrcpVendorDependentHeader  avrcp_header
  10 [+1]    UInt                        packet_type
  11 [+2]    UInt                        parameter_length
  if avrcp_header.pdu_id == 0x31:
    13 [+1]  UInt                        event_id

  if avrcp_header.pdu_id == 0x31 && parameter_length == 2 && event_id == 0x01:
    14 [+1]  AvrcpPlayStatus             playback_status

  if avrcp_header.pdu_id == 0x31 && parameter_length == 5 && event_id == 0x05:
    14 [+4]  UInt                        playback_interval

  if avrcp_header.pdu_id == 0x31 && parameter_length == 2 && event_id == 0x0D:
    14 [+1]  UInt                        volume

  if avrcp_header.pdu_id == 0x50:
    13 [+1]  UInt                        absolute_volume
