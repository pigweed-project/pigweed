load("//pw_bloat:pw_cc_size_binary.bzl", "pw_cc_size_binary")

package(
    default_visibility = ["//visibility:public"],
    features = ["-layering_check"],
)

licenses(["notice"])

_DEPS = [
    "//pw_bloat:bloat_this_binary",
    "//pw_bytes",
    "//pw_cobs/cpp:pw_cobs",
    "//pw_log",
    "//pw_preprocessor",
    "//pw_result",
    "//pw_span",
    "//pw_status",
]

pw_cc_size_binary(
    name = "base",
    srcs = ["cobs_size_report.cc"],
    deps = _DEPS,
)

pw_cc_size_binary(
    name = "encode_decode",
    srcs = ["cobs_size_report.cc"],
    copts = ["-DENABLE_ENCODE_DECODE=1"],
    deps = _DEPS,
)

pw_cc_size_binary(
    name = "in_place",
    srcs = ["cobs_size_report.cc"],
    copts = ["-DENABLE_IN_PLACE=1"],
    deps = _DEPS,
)

pw_cc_size_binary(
    name = "streaming_decoder",
    srcs = ["cobs_size_report.cc"],
    copts = ["-DENABLE_STREAMING_DECODER=1"],
    deps = _DEPS,
)

pw_cc_size_binary(
    name = "all_cobs",
    srcs = ["cobs_size_report.cc"],
    copts = [
        "-DENABLE_ENCODE_DECODE=1",
        "-DENABLE_IN_PLACE=1",
        "-DENABLE_STREAMING_DECODER=1",
    ],
    deps = _DEPS,
)
