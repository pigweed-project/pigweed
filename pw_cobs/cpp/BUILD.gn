import("//build_overrides/pigweed.gni")

import("$dir_pw_build/python_action.gni")
import("$dir_pw_build/target_types.gni")
import("$dir_pw_perf_test/perf_test.gni")
import("$dir_pw_unit_test/test.gni")

config("public_include_path") {
  include_dirs = [ "public" ]
  visibility = [ ":*" ]
}

pw_source_set("pw_cobs") {
  public_configs = [ ":public_include_path" ]
  public = [ "public/pw_cobs/cobs.h" ]
  sources = [ "cobs.cc" ]
  public_deps = [
    "$dir_pw_assert:assert",
    "$dir_pw_bytes",
    "$dir_pw_containers:iterator",
    "$dir_pw_containers:storage",
    "$dir_pw_result",
    "$dir_pw_span",
    "$dir_pw_status",
  ]
}

pw_python_action("generate_cobs_generated_test") {
  outputs = [ "$target_gen_dir/cobs_generated_test.cc" ]
  script = "../py/cobs_generated_test.py"
  args = [ "--generate-cc-test" ] + rebase_path(outputs, root_build_dir)
  python_deps = [
    "$dir_pw_build/py",
    "../py",
  ]
  visibility = [ ":*" ]
}

pw_test("cobs_test") {
  sources = [ "cobs_test.cc" ]
  source_gen_deps = [ ":generate_cobs_generated_test" ]
  deps = [
    ":pw_cobs",
    "$dir_pw_bytes",
    "$dir_pw_span",
    "$dir_pw_status",
  ]
}

pw_test_group("tests") {
  tests = [ ":cobs_test" ]
}

pw_perf_test("cobs_perf_test") {
  sources = [ "cobs_perf_test.cc" ]
  deps = [
    ":pw_cobs",
    "$dir_pw_assert:check",
    "$dir_pw_bytes",
  ]
}
