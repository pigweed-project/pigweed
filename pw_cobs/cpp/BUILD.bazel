load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//pw_perf_test:pw_cc_perf_test.bzl", "pw_cc_perf_test")
load("//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

cc_library(
    name = "pw_cobs",
    srcs = [
        "cobs.cc",
    ],
    hdrs = [
        "public/pw_cobs/cobs.h",
    ],
    strip_include_prefix = "public",
    deps = [
        "//pw_assert:assert",
        "//pw_bytes",
        "//pw_containers:iterator",
        "//pw_containers:storage",
        "//pw_result",
        "//pw_span",
        "//pw_status",
    ],
)

filegroup(
    name = "doxygen",
    srcs = [
        "public/pw_cobs/cobs.h",
    ],
)

pw_cc_test(
    name = "cobs_test",
    srcs = ["cobs_test.cc"],
    deps = [
        ":pw_cobs",
        "//pw_bytes",
        "//pw_status",
    ],
)

pw_cc_perf_test(
    name = "cobs_perf_test",
    srcs = ["cobs_perf_test.cc"],
    deps = [
        ":pw_cobs",
        "//pw_assert:check",
        "//pw_bytes",
        "//pw_perf_test",
    ],
)

run_binary(
    name = "generate_cobs_generated_test",
    outs = ["cobs_generated_test.cc"],
    args = [
        "--generate-cc-test",
        "$(execpath :cobs_generated_test.cc)",
    ],
    tool = "//pw_cobs/py:generate_cobs_test",
)

pw_cc_test(
    name = "cobs_generated_test",
    srcs = [":generate_cobs_generated_test"],
    deps = [
        ":pw_cobs",
        "//pw_bytes",
        "//pw_span",
        "//pw_status",
    ],
)
