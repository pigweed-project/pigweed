package {
    default_applicable_licenses: ["external_pigweed_license"],
}

python_binary_host {
    name: "pw_emu_py",
    main: "pw_emu/__main__.py",
    srcs: [
        "pw_emu/*.py",
    ],
    libs: [
        "pw_env_setup_py_lib",
        "pyserial",
    ],
    // pw_emu/core.py imports psutil, which is not present in the Android
    // source tree, and pw_emu/__main__.py imports SerialException from serial,
    // which pyserial re-exports via wildcard import.
    strict_deps: false,
}

python_library_host {
    name: "pw_emu_py_lib",
    srcs: [
        "pw_emu/*.py",
    ],
    // pw_emu/core.py imports psutil, which is not present in the Android
    // source tree, and pw_emu/__main__.py imports SerialException from serial,
    // which pyserial re-exports via wildcard import.
    strict_deps: false,
}
