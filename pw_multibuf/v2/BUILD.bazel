load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

### Backend for pw_multibuf

# LINT.IfChange

cc_library(
    name = "v2",
    hdrs = [
        "public_overrides/pw_multibuf_backend/allocator.h",
        "public_overrides/pw_multibuf_backend/allocator_async.h",
        "public_overrides/pw_multibuf_backend/chunk.h",
        "public_overrides/pw_multibuf_backend/from_span.h",
        "public_overrides/pw_multibuf_backend/header_chunk_region_tracker.h",
        "public_overrides/pw_multibuf_backend/multibuf.h",
        "public_overrides/pw_multibuf_backend/observer.h",
        "public_overrides/pw_multibuf_backend/simple_allocator.h",
        "public_overrides/pw_multibuf_backend/single_chunk_region_tracker.h",
    ],
    strip_include_prefix = "public_overrides",
    deps = [
        ":multibuf",
        "//pw_multibuf/v1_adapter:allocator",
        "//pw_multibuf/v1_adapter:chunk",
        "//pw_multibuf/v1_adapter:from_span",
        "//pw_multibuf/v1_adapter:multibuf",
        "//pw_multibuf/v1_adapter:simple_allocator",
        "//pw_multibuf/v1_adapter:single_chunk_region_tracker",
    ],
)

# LINT.ThenChange(BUILD.gn, CMakeLists.txt)

### Libraries and tests

# LINT.IfChange
cc_library(
    name = "properties",
    hdrs = ["public/pw_multibuf/v2/properties.h"],
    strip_include_prefix = "public",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "iterators",
    hdrs = [
        "public/pw_multibuf/v2/chunks.h",
        "public/pw_multibuf/v2/internal/byte_iterator.h",
        "public/pw_multibuf/v2/internal/chunk_iterator.h",
        "public/pw_multibuf/v2/internal/entry.h",
    ],
    strip_include_prefix = "public",
    visibility = ["//pw_multibuf:__subpackages__"],
    deps = [
        "//pw_assert:assert",
        "//pw_bytes",
        "//pw_containers:dynamic_deque",
        "//pw_preprocessor",
    ],
)

cc_library(
    name = "iterator_testing",
    testonly = True,
    hdrs = ["private/pw_multibuf_private/iterator_testing.h"],
    strip_include_prefix = "private",
    visibility = ["//visibility:private"],
    deps = [
        ":iterators",
        "//pw_allocator:bump_allocator",
        "//pw_containers:storage",
        "//pw_unit_test",
    ],
)

pw_cc_test(
    name = "chunk_iterator_test",
    srcs = ["chunk_iterator_test.cc"],
    deps = [
        ":iterator_testing",
        ":iterators",
        "//pw_bytes",
        "//pw_containers:dynamic_deque",
    ],
)

pw_cc_test(
    name = "byte_iterator_test",
    srcs = ["byte_iterator_test.cc"],
    deps = [
        ":iterator_testing",
        ":iterators",
    ],
)
# LINT.ThenChange(BUILD.gn, CMakeLists.txt)

# LINT.IfChange
cc_library(
    name = "multibuf",
    srcs = ["generic_multibuf.cc"],
    hdrs = [
        "public/pw_multibuf/v2/multibuf.h",
        "public/pw_multibuf/v2/observer.h",
    ],
    implementation_deps = [
        "//pw_assert:check",
    ],
    strip_include_prefix = "public",
    visibility = ["//visibility:public"],
    deps = [
        ":iterators",
        ":properties",
        "//pw_allocator",
        "//pw_allocator:null_allocator",
        "//pw_buf",
        "//pw_bytes",
        "//pw_containers:algorithm",
        "//pw_containers:dynamic_deque",
        "//pw_status",
    ],
)
# LINT.ThenChange(../Android.bp, BUILD.gn, CMakeLists.txt)

# LINT.IfChange
# Expose source files to be reused by v1_adapter.
filegroup(
    name = "multibuf_test_srcs",
    testonly = True,
    srcs = [
        "multibuf_nc_test.cc",
        "multibuf_test.cc",
    ],
    visibility = ["//pw_multibuf:__subpackages__"],
)

cc_library(
    name = "multibuf_testing",
    testonly = True,
    hdrs = ["private/pw_multibuf_private/multibuf_testing.h"],
    defines = ["PW_MULTIBUF_INCLUDE_V1_ADAPTERS=0"],
    strip_include_prefix = "private",
    visibility = ["//visibility:private"],
    deps = [
        ":v2",
        "//pw_multibuf:pw_multibuf.facade",
    ],
)

pw_cc_test(
    name = "multibuf_test",
    srcs = [":multibuf_test_srcs"],
    defines = ["PW_MULTIBUF_INCLUDE_V1_ADAPTERS=0"],
    has_nc_test = True,
    deps = [
        ":multibuf_testing",
        ":v2",
        "//pw_allocator:chunk_pool",
        "//pw_allocator:testing",
        "//pw_assert:check",
        "//pw_buf",
        "//pw_bytes",
        "//pw_multibuf:pw_multibuf.facade",
        "//pw_result",
        "//pw_status",
    ],
)
# LINT.ThenChange(BUILD.gn, CMakeLists.txt)

