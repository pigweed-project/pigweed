load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("//pw_build:pw_cc_binary.bzl", "pw_cc_binary")
load("//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")

package(
    default_visibility = ["//visibility:public"],
)

licenses(["notice"])

cc_library(
    name = "alarm_timer",
    hdrs = ["public/pw_rpc/fuzz/alarm_timer.h"],
    strip_include_prefix = "public",
    visibility = [":__subpackages__"],
    deps = [
        "//pw_chrono:system_clock",
        "//pw_chrono:system_timer",
    ],
)

pw_cc_test(
    name = "alarm_timer_test",
    srcs = ["alarm_timer_test.cc"],
    deps = [
        ":alarm_timer",
        "//pw_chrono:system_clock",
        "//pw_sync:binary_semaphore",
    ],
)

cc_library(
    name = "argparse",
    srcs = ["argparse.cc"],
    hdrs = ["public/pw_rpc/fuzz/argparse.h"],
    implementation_deps = [
        "//pw_assert:check",
        "//pw_log",
        "//pw_string:builder",
    ],
    strip_include_prefix = "public",
    visibility = [":__subpackages__"],
    deps = [
        "//pw_containers:vector",
        "//pw_status",
    ],
)

pw_cc_test(
    name = "argparse_test",
    srcs = ["argparse_test.cc"],
    deps = [
        ":argparse",
        "//pw_string:builder",
    ],
)

cc_library(
    name = "engine",
    srcs = ["engine.cc"],
    hdrs = ["public/pw_rpc/fuzz/engine.h"],
    implementation_deps = [
        "//pw_assert:check",
        "//pw_log",
    ],
    strip_include_prefix = "public",
    visibility = [":__subpackages__"],
    deps = [
        ":alarm_timer",
        "//pw_bytes",
        "//pw_chrono:system_clock",
        "//pw_containers:vector",
        "//pw_random",
        "//pw_rpc",
        "//pw_rpc:benchmark",
        "//pw_rpc:benchmark_raw_rpc",
        "//pw_span",
        "//pw_status",
        "//pw_string:format",
        "//pw_sync:condition_variable",
        "//pw_sync:lock_annotations",
        "//pw_sync:mutex",
        "//pw_sync:timed_mutex",
        "//pw_thread:thread",
    ],
)

pw_cc_test(
    name = "engine_test",
    srcs = ["engine_test.cc"],
    target_compatible_with = incompatible_with_mcu(),
    deps = [
        ":engine",
        "//pw_containers:vector",
        "//pw_log",
        "//pw_rpc:benchmark",
        "//pw_rpc:client_server_testing",
        "//pw_rpc:client_server_testing_threaded",
        "//pw_rpc:fake_channel_output",
        "//pw_thread:non_portable_test_thread_options",
        "//pw_thread_stl:non_portable_test_thread_options",
    ],
)

pw_cc_binary(
    name = "client_fuzzer",
    testonly = True,
    srcs = ["client_fuzzer.cc"],
    target_compatible_with = incompatible_with_mcu(),
    deps = [
        ":argparse",
        ":engine",
        "//pw_containers:vector",
        "//pw_log",
        "//pw_rpc",
        "//pw_rpc:integration_testing",
        "//pw_span",
        "//pw_status",
    ],
)
