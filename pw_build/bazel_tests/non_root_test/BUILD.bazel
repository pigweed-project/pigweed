load("@pigweed//pw_build:python.bzl", "pw_py_test")
load("@pigweed//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")
load(":canary_test.bzl", "no_leaked_mcu_toolchain_test", "probe_mcu_cc_toolchain")

package(default_visibility = ["//visibility:private"])

platform(
    name = "cortex_m0_canary_platform",
    constraint_values = [
        "@pigweed//pw_build/constraints/arm:cortex-m0",
        "@platforms//cpu:armv6-m",
        "@platforms//os:none",
    ],
)

probe_mcu_cc_toolchain(
    name = "mcu_cc_toolchain_probe",
    tags = ["manual"],
)

no_leaked_mcu_toolchain_test(
    name = "no_leaked_mcu_toolchain_test",
    size = "small",
    target_under_test = ":mcu_cc_toolchain_probe",
)

pw_cc_test(
    name = "non_root_cc_test",
    size = "small",
    srcs = ["non_root_cc_test.cc"],
    deps = [
        "@pigweed//pw_result",
        "@pigweed//pw_span",
        "@pigweed//pw_status",
        "@pigweed//pw_string",
    ],
)

pw_py_test(
    name = "non_root_py_test",
    size = "small",
    srcs = ["non_root_py_test.py"],
    deps = [
        "@pigweed//pw_status/py:pw_status",
    ],
)
