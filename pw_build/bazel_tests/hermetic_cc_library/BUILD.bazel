load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//pw_build:pw_hermetic_cc_library.bzl", "pw_hermetic_cc_library")
load("//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "private_dep",
    srcs = ["private_dep.cc"],
    hdrs = ["private_dep.h"],
)

pw_hermetic_cc_library(
    name = "hermetic_test_lib",
    srcs = ["hermetic_test_lib.cc"],
    hdrs = ["hermetic_test_lib.h"],
    global_symbols = ["pw_hermetic_test_func"],
    target_compatible_with = select({
        # TODO: https://pwbug.dev/529790473 - Find a solution for sanitizers.
        "//pw_toolchain/host_clang:asan_enabled": ["@platforms//:incompatible"],
        "//pw_toolchain/host_clang:msan_enabled": ["@platforms//:incompatible"],
        "//pw_toolchain/host_clang:tsan_enabled": ["@platforms//:incompatible"],
        "//pw_toolchain/host_clang:ubsan_enabled": ["@platforms//:incompatible"],
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":private_dep"],
)

pw_cc_test(
    name = "hermetic_cc_library_test",
    srcs = ["hermetic_cc_library_test.cc"],
    target_compatible_with = select({
        # TODO: https://pwbug.dev/529790473 - Find a solution for sanitizers.
        "//pw_toolchain/host_clang:asan_enabled": ["@platforms//:incompatible"],
        "//pw_toolchain/host_clang:msan_enabled": ["@platforms//:incompatible"],
        "//pw_toolchain/host_clang:tsan_enabled": ["@platforms//:incompatible"],
        "//pw_toolchain/host_clang:ubsan_enabled": ["@platforms//:incompatible"],
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":hermetic_test_lib"],
)
