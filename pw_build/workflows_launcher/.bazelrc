common --enable_platform_specific_config
common --@pigweed//pw_env_setup/py:pigweed_json=@pigweed//:pigweed_json
common --experimental_propagate_custom_flag=@pigweed//pw_env_setup/py:pigweed_json

# LINT.IfChange(proto_toolchains)
# Enable prebuilt protobuf toolchains
build --incompatible_enable_proto_toolchain_resolution
build --@com_google_protobuf//bazel/toolchains:prefer_prebuilt_protoc
build --extra_toolchains=@pigweed//pw_build:pw_python_proto_toolchain_toolchain
# LINT.ThenChange(//pw_build/pigweed.bazelrc:proto_toolchains)
