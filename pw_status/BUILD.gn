import("//build_overrides/pigweed.gni")

import("$dir_pw_build/module_config.gni")
import("$dir_pw_build/target_types.gni")
import("$dir_pw_enum/pw_cc_enum_source_set.gni")
import("$dir_pw_unit_test/test.gni")

declare_args() {
  # The build target that overrides the default configuration options for this
  # module. This should point to a source set that provides defines through a
  # public config (which may -include a file or add defines directly).
  pw_status_CONFIG = pw_build_DEFAULT_MODULE_CONFIG
}

config("public_include_path") {
  include_dirs = [ "public" ]
  visibility = [ ":*" ]
}

pw_source_set("pw_status") {
  public_configs = [ ":public_include_path" ]
  public_deps = [
    "$dir_pw_enum",
    pw_status_CONFIG,
  ]
  public = [
    "public/pw_status/status.h",
    "public/pw_status/status_base.h",
    "public/pw_status/status_with_size.h",
    "public/pw_status/try.h",
  ]
  sources = [
    "public/pw_status/internal/config.h",
    "public/pw_status/internal/status_storage.h",
    "status.cc",
  ]
}

pw_source_set("message") {
  public_configs = [ ":public_include_path" ]
  public_deps = [
    ":pw_status",
    "$dir_pw_enum",
    "$dir_pw_tokenizer",
  ]
  public = [ "public/pw_status/message.h" ]
}

config("check_if_used_config") {
  defines = [ "PW_STATUS_CFG_CHECK_IF_USED=1" ]
  visibility = [ ":*" ]
}

# Use this for pw_status_CONFIG to require pw::Status objects to be used.
pw_source_set("check_if_used") {
  public_configs = [ ":check_if_used_config" ]
}

config("string_messages_config") {
  defines = [ "PW_STATUS_CFG_MESSAGES=PW_STATUS_CFG_MESSAGES_STRING" ]
  visibility = [ ":*" ]
}

# Use this for pw_status_CONFIG to store status messages as string pointers.
pw_source_set("string_messages") {
  public_configs = [ ":string_messages_config" ]
}

config("tokenized_messages_config") {
  defines = [ "PW_STATUS_CFG_MESSAGES=PW_STATUS_CFG_MESSAGES_TOKENIZED" ]
  visibility = [ ":*" ]
}

# Use this for pw_status_CONFIG to store status messages as pw_tokenizer tokens.
pw_source_set("tokenized_messages") {
  public_configs = [ ":tokenized_messages_config" ]
}

pw_test_group("tests") {
  tests = [
    ":message_token_test",
    ":status_test",
    ":status_base_enum_test",
    ":status_base_test",
    ":status_with_size_test",
    ":try_test",
  ]
}

pw_test("status_test") {
  deps = [
    ":pw_status",
    "$dir_pw_enum",
    "$dir_pw_unit_test:constexpr",
  ]
  sources = [
    "status_test.cc",
    "status_test_c.c",
  ]
}

pw_cc_enum_source_set("status_test_enum") {
  enum_headers = [ "test_enums/status_test_enum.h" ]
  include_dirs = [ "test_enums" ]
  testonly = pw_unit_test_TESTONLY
}

pw_test("status_base_enum_test") {
  deps = [
    ":message",
    ":pw_status",
    ":status_test_enum",
    "$dir_pw_enum",
    "$dir_pw_result",
    "$dir_pw_tokenizer",
    "$dir_pw_unit_test:constexpr",
  ]
  sources = [ "status_base_enum_test.cc" ]
  negative_compilation_tests = true
}

pw_test("status_base_test") {
  deps = [
    ":message",
    ":pw_status",
    "$dir_pw_enum",
    "$dir_pw_tokenizer",
    "$dir_pw_unit_test:constexpr",
  ]
  sources = [ "status_base_test.cc" ]
  negative_compilation_tests = true
}

pw_test("message_token_test") {
  deps = [
    ":message",
    ":pw_status",
    "$dir_pw_bytes",
    "$dir_pw_result",
    "$dir_pw_tokenizer:decoder",
    "$dir_pw_tokenizer:detokenize_from_this_program",
  ]
  sources = [ "message_token_test.cc" ]

  # This test requires a linker script to load the tokenizer sections. This is
  # currently only supported on Linux.
  enable_if = current_os == "linux"

  configs = [ "$dir_pw_tokenizer:detokenize_from_this_program_linker_script" ]
}

pw_test("status_with_size_test") {
  deps = [ ":pw_status" ]
  sources = [ "status_with_size_test.cc" ]
}

pw_test("try_test") {
  deps = [ ":pw_status" ]
  sources = [ "try_test.cc" ]
}
