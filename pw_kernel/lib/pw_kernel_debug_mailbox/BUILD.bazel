load("@pigweed//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library")
load("//pw_kernel:flags.bzl", "KERNEL_TEST_DEPS", "KERNEL_TEST_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "pw_kernel_debug_mailbox",
    srcs = [
        "lib.rs",
    ],
    crate_features = select({
        "@pigweed//pw_build/constraints/rust:std": [
            "std",
        ],
        "//conditions:default": [],
    }) + select({
        "//pw_kernel/lib/pw_atomic:riscv32_without_atomics": [],
        "//conditions:default": ["builtin_atomics"],
    }),
    edition = "2024",
    proc_macro_deps = [
        "@rust_crates//:paste",
    ],
    rustc_flags = KERNEL_TEST_RUSTC_FLAGS,
    tags = ["kernel"],
    deps = [
        "//pw_kernel/lib/pw_atomic",
    ] + KERNEL_TEST_DEPS,
)

rust_doc_test(
    name = "pw_kernel_debug_mailbox_doc_test",
    crate = ":pw_kernel_debug_mailbox",
    tags = ["kernel"],
    target_compatible_with = incompatible_with_mcu(),
)

rust_library(
    name = "pw_kernel_debug_mailbox_protocol",
    srcs = [
        "protocol.rs",
    ],
    edition = "2024",
    rustc_flags = KERNEL_TEST_RUSTC_FLAGS,
    tags = ["kernel"],
    deps = [
        "@rust_crates//:zerocopy",
    ],
)

rust_doc_test(
    name = "pw_kernel_debug_mailbox_protocol_doc_test",
    crate = ":pw_kernel_debug_mailbox_protocol",
    tags = ["kernel"],
    target_compatible_with = incompatible_with_mcu(),
)
