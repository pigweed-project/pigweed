load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//pw_build:compatibility.bzl", "incompatible_with_mcu")
load("//pw_build:python.bzl", "pw_py_binary", "pw_py_library", "pw_py_test")
load("//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")

package(default_visibility = ["//visibility:public"])

pw_py_library(
    name = "generate_printf_cases_lib",
    testonly = True,
    srcs = ["generate_printf_cases.py"],
    imports = ["."],
    deps = [
        "//pw_build/py:pw_build",
        "//pw_codegen/py:pw_codegen",
        "@pigweed_python_packages//pyyaml",
    ],
)

pw_py_binary(
    name = "generate_printf_cases",
    testonly = True,
    srcs = ["generate_printf_cases.py"],
    main = "generate_printf_cases.py",
    deps = [
        ":generate_printf_cases_lib",
        "//pw_build/py:pw_build",
        "//pw_codegen/py:pw_codegen",
        "@pigweed_python_packages//pyyaml",
    ],
)

pw_py_test(
    name = "generate_printf_cases_test",
    srcs = [
        "generate_printf_cases_test.py",
    ],
    deps = [
        ":generate_printf_cases_lib",
    ],
)

run_binary(
    name = "generate_printf_cases_h",
    testonly = True,
    srcs = [
        "printf_cases.h.jinja",
        "printf_cases.yaml",
    ],
    outs = ["printf_cases.h"],
    args = [
        "--yaml",
        "$(execpath printf_cases.yaml)",
        "--template",
        "$(execpath printf_cases.h.jinja)",
        "--output",
        "$(execpath printf_cases.h)",
    ],
    tool = ":generate_printf_cases",
)

run_binary(
    name = "generate_printf_cases_rs",
    testonly = True,
    srcs = [
        "printf_cases.rs.jinja",
        "printf_cases.yaml",
    ],
    outs = ["printf_cases.rs"],
    args = [
        "--yaml",
        "$(execpath printf_cases.yaml)",
        "--template",
        "$(execpath printf_cases.rs.jinja)",
        "--output",
        "$(execpath printf_cases.rs)",
    ],
    tool = ":generate_printf_cases",
)

pw_cc_test(
    name = "snprintf_reference_cc_test",
    srcs = [
        "snprintf_reference_test.cc",
        ":generate_printf_cases_h",
    ],
    target_compatible_with = incompatible_with_mcu(),
    deps = [
        "//pw_preprocessor",
    ],
)

rust_test(
    name = "printf_conformance_rust_test",
    srcs = ["printf_conformance_test.rs"],
    compile_data = [
        ":generate_printf_cases_rs",
    ],
    edition = "2021",
    target_compatible_with = incompatible_with_mcu() + select({
        "//pw_build/constraints/rust:std": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//pw_format/rust:pw_format",
    ],
)
